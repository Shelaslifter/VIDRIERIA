---
// Hero.astro
import { Image } from 'astro:assets';
---

<section id="inicio" class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-slate-950 pb-32 pt-32">
  <!-- Fondo con efecto Ken Burns -->
  <div class="absolute inset-0 z-0">
    <Image
      src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop"
      alt="Fachada moderna con vidrio templado"
      width={2070}
      height={1380}
      loading="eager"
      class="h-full w-full object-cover object-center motion-safe:animate-ken-burns"
    />
    <!-- Degradado para legibilidad + brillo cian sutil -->
    <div class="absolute inset-0 bg-linear-to-b from-slate-950/80 via-slate-950/60 to-slate-950/90"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(34,211,238,0.18),transparent_60%)]"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center lg:px-8">
    <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-cyan-200 backdrop-blur-md">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75 motion-safe:animate-ping"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-400"></span>
      </span>
      Calidad Premium
    </span>

    <h1 class="mt-8 text-4xl font-bold leading-[1.05] tracking-tight text-white text-balance sm:text-6xl lg:text-7xl">
      Transparencia y <span class="bg-linear-to-r from-cyan-300 via-sky-300 to-blue-400 bg-clip-text text-transparent">Elegancia</span> para tus Espacios
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 text-pretty sm:text-xl">
      Especialistas en diseño, fabricación e instalación de vidrio templado y cancelería de aluminio a medida.
    </p>

    <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
      <a href="/contacto" class="btn-primary group/btn px-8 py-4 text-base">
        Cotizar mi proyecto
        <svg class="h-5 w-5 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
        </svg>
      </a>
      <a href="/#proyectos" class="btn-ghost px-8 py-4 text-base">
        Ver galería
      </a>
    </div>
  </div>
</section>
