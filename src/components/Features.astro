---
// Features.astro
interface Feature {
  title: string;
  description: string;
  icon: string;
}

const iconClass = 'h-6 w-6 text-cyan-600 transition-colors duration-500 group-hover:text-white';

const features: Feature[] = [
  {
    title: "Materiales Premium",
    description: "Cristal templado y aluminio de la más alta resistencia y durabilidad.",
    icon: `<svg class="${iconClass}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>`
  },
  {
    title: "Instaladores Expertos",
    description: "Mano de obra calificada con años de experiencia en cancelería.",
    icon: `<svg class="${iconClass}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
  },
  {
    title: "Entregas Puntuales",
    description: "Respetamos los tiempos acordados para que tu obra no se detenga.",
    icon: `<svg class="${iconClass}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  },
  {
    title: "Garantía Total",
    description: "Respaldamos cada uno de nuestros trabajos para tu tranquilidad.",
    icon: `<svg class="${iconClass}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  }
];
---

<!-- Panel de cristal que se superpone al borde inferior del Hero -->
<section class="relative z-20 -mt-20 px-6 lg:px-8">
  <div class="mx-auto max-w-7xl rounded-3xl border border-white/60 bg-white/85 p-3 shadow-2xl shadow-slate-900/10 backdrop-blur-xl backdrop-saturate-150 sm:p-4">
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((feature) => (
        <div class="group flex flex-col items-center rounded-2xl p-6 text-center transition-all duration-500 ease-premium hover:-translate-y-1 hover:bg-white hover:shadow-xl hover:shadow-slate-900/5 lg:p-8">
          <div class="mb-5 grid h-14 w-14 place-items-center rounded-2xl bg-cyan-50 ring-1 ring-cyan-100 transition-all duration-500 ease-premium group-hover:scale-110 group-hover:bg-linear-to-br group-hover:from-cyan-500 group-hover:to-blue-600 group-hover:shadow-lg group-hover:shadow-cyan-500/30 group-hover:ring-transparent">
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="text-lg font-bold tracking-tight text-slate-900">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
