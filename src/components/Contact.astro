---
// Contact.astro
---

<section id="contacto" class="py-24 bg-slate-50 relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-cyan-100/50 blur-3xl"></div>
    <div class="absolute bottom-0 left-[-10%] w-3/4 h-1/2 rounded-full bg-slate-200/50 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="bg-white rounded-3xl shadow-xl overflow-hidden flex flex-col lg:flex-row">
      
      <!-- Contact Info -->
      <div class="bg-slate-900 text-white p-10 lg:p-16 lg:w-2/5 flex flex-col justify-between">
        <div>
          <h2 class="text-3xl font-extrabold mb-4">¿Listo para empezar?</h2>
          <p class="text-slate-300 text-lg mb-10">
            Cuéntanos sobre tu proyecto y te daremos una cotización a medida sin compromiso.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start">
              <svg class="w-6 h-6 text-cyan-500 mt-1 mr-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <div>
                <h4 class="font-semibold">Ubicación</h4>
                <p class="text-slate-400">Av. Principal 123, Zona Centro, Ciudad</p>
              </div>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-cyan-500 mt-1 mr-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              <div>
                <h4 class="font-semibold">Teléfono</h4>
                <p class="text-slate-400">+52 (55) 1234 5678</p>
              </div>
            </div>
            <div class="flex items-start">
              <svg class="w-6 h-6 text-cyan-500 mt-1 mr-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <div>
                <h4 class="font-semibold">Email</h4>
                <p class="text-slate-400">contacto@vidrieria.com</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div id="cotizar" class="p-10 lg:p-16 lg:w-3/5">
        <h3 class="text-2xl font-bold text-slate-900 mb-6">Solicitar Cotización</h3>
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Mensaje enviado. Esto es una demostración.');">
          <div>
            <label for="nombre" class="block text-sm font-medium text-slate-700 mb-1">Nombre completo</label>
            <input type="text" id="nombre" name="nombre" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 outline-none transition-colors bg-slate-50" placeholder="Ej. Juan Pérez">
          </div>
          
          <div>
            <label for="servicio" class="block text-sm font-medium text-slate-700 mb-1">Servicio de interés</label>
            <select id="servicio" name="servicio" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 outline-none transition-colors bg-slate-50">
              <option value="" disabled selected>Selecciona una opción</option>
              <option value="vidrio-templado">Vidrio Templado</option>
              <option value="canceleria">Cancelería de Aluminio</option>
              <option value="domos">Domos y Techos</option>
              <option value="mantenimiento">Mantenimiento</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-medium text-slate-700 mb-1">Detalles del proyecto</label>
            <textarea id="mensaje" name="mensaje" rows="4" required class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 outline-none transition-colors bg-slate-50 resize-none" placeholder="Describe brevemente lo que necesitas..."></textarea>
          </div>

          <button type="submit" class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-3.5 px-8 rounded-lg shadow-md hover:shadow-lg transition-all duration-300">
            Enviar Solicitud
          </button>
        </form>
      </div>

    </div>
  </div>
</section>
