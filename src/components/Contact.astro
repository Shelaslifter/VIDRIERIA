---
// Contact.astro
import { getSiteSettings } from '../lib/settings';

const settings = await getSiteSettings();
---

<section id="contacto" class="relative overflow-hidden bg-slate-50 py-16 md:py-20 scroll-mt-24">
  <!-- Decorative background elements -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-cyan-200/40 blur-[120px]"></div>
    <div class="absolute -left-[10%] bottom-0 h-1/2 w-3/4 rounded-full bg-blue-200/30 blur-[120px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col overflow-hidden rounded-[2.5rem] bg-white shadow-2xl shadow-slate-900/10 ring-1 ring-slate-200 lg:flex-row">
      
      <!-- Contact Info Sidebar -->
      <div class="relative flex flex-col justify-between overflow-hidden bg-slate-950 p-10 text-white lg:w-2/5 lg:p-16">
        <!-- Inner glow -->
        <div class="absolute inset-0 bg-linear-to-br from-cyan-500/10 to-transparent pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 h-64 w-64 rounded-full bg-cyan-500/20 blur-[80px] pointer-events-none"></div>

        <div class="relative z-10">
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">¿Listo para empezar?</h2>
          <p class="mt-4 text-lg text-slate-300">
            Cuéntanos sobre tu proyecto y te daremos una cotización a medida sin compromiso.
          </p>
          
          <div class="mt-12 space-y-8">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/5 ring-1 ring-white/10">
                <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h4 class="font-semibold text-white">Ubicación</h4>
                <p id="contact-address" class="mt-1 text-slate-400">{settings.address}</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/5 ring-1 ring-white/10">
                <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h4 class="font-semibold text-white">Teléfono</h4>
                <p id="contact-phone" class="mt-1 text-slate-400">{settings.phone_display}</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/5 ring-1 ring-white/10">
                <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h4 class="font-semibold text-white">Email</h4>
                <p id="contact-email" class="mt-1 text-slate-400">{settings.email}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="p-10 lg:w-3/5 lg:p-16">
        <form id="main-contact-form" data-wa={settings.whatsapp_number} class="space-y-6">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label for="nombre" class="block text-sm font-medium text-slate-700">Nombre completo</label>
              <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                class="input-field mt-2" 
                placeholder="Juan Pérez" 
                required 
              />
            </div>
            <div>
              <label for="telefono" class="block text-sm font-medium text-slate-700">Teléfono</label>
              <input 
                type="tel" 
                id="telefono" 
                name="telefono" 
                class="input-field mt-2" 
                placeholder="55 1234 5678" 
                required 
              />
            </div>
          </div>

          <div>
            <label for="servicio" class="block text-sm font-medium text-slate-700">Servicio de interés</label>
            <select 
              id="servicio" 
              name="servicio" 
              class="input-field mt-2" 
              required
            >
              <option value="" disabled selected>Selecciona un servicio</option>
              <option value="templado">Vidrio Templado</option>
              <option value="ventanas">Ventanas y Puertas</option>
              <option value="domos">Domos y Techos</option>
              <option value="barandales">Barandales</option>
              <option value="otro">Otro / Proyecto Especial</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-medium text-slate-700">Mensaje o detalles del proyecto</label>
            <textarea 
              id="mensaje" 
              name="mensaje" 
              rows="4" 
              class="input-field mt-2 resize-none" 
              placeholder="Cuéntanos medidas aproximadas, tipo de espacio o cualquier detalle importante..." 
              required
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="btn-primary w-full py-4 text-base"
          >
            Enviar solicitud de cotización
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  import { getCachedSiteSettings } from '../lib/settings';

  const form = document.getElementById('main-contact-form') as HTMLFormElement;

  async function syncContactInfo() {
    try {
      const settings = await getCachedSiteSettings();
      if (settings) {
        if (settings.address) {
          const el = document.getElementById('contact-address');
          if (el) el.textContent = settings.address;
        }
        if (settings.phone_display) {
          const el = document.getElementById('contact-phone');
          if (el) el.textContent = settings.phone_display;
        }
        if (settings.email) {
          const el = document.getElementById('contact-email');
          if (el) el.textContent = settings.email;
        }
        if (form && settings.whatsapp_number) {
          form.dataset.wa = settings.whatsapp_number;
        }
      }
    } catch (e) {}
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombreInput = document.getElementById('nombre') as HTMLInputElement;
    const telInput = document.getElementById('telefono') as HTMLInputElement;
    const servInput = document.getElementById('servicio') as HTMLSelectElement;
    const msgInput = document.getElementById('mensaje') as HTMLTextAreaElement;

    const nombre = nombreInput?.value.trim() || '';
    const telefono = telInput?.value.trim() || '';
    const servicio = servInput?.selectedOptions[0]?.text || servInput?.value || 'General';
    const mensaje = msgInput?.value.trim() || '';

    const waNumber = form.dataset.wa || '525627320080';
    const texto = `Hola, soy *${nombre}* (${telefono}). Me gustaría solicitar una cotización para: *${servicio}*.\n\n*Detalles del proyecto:*\n${mensaje}`;

    window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(texto)}`, '_blank');
  });

  syncContactInfo();
</script>
