---
// Logo.astro — Logotipo oficial de DELTALUM (Aluminio y Vidrio en General)
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class={`group/logo inline-flex items-center gap-3 ${className}`} aria-label="DELTALUM - Ir al inicio">
  <!-- Isotipo Vectorial Oficial Deltalum -->
  <span class="relative flex h-10 w-11 shrink-0 items-center justify-center rounded-xl bg-white/95 p-1.5 shadow-lg shadow-black/25 ring-1 ring-white/30 transition-transform duration-500 ease-premium group-hover/logo:scale-105">
    <svg class="h-full w-full" viewBox="0 0 100 90" fill="none" aria-hidden="true">
      <polygon points="4,86 50,4 58.5,19 21,86" fill="#1B365D" />
      <polygon points="25.5,86 61,23.5 69.5,38.5 42.5,86" fill="#0077C8" />
      <polygon points="47,86 72,43 96,86" fill="#D9232A" />
    </svg>
  </span>

  <!-- Tipografía Oficial Deltalum -->
  <div class="flex flex-col leading-none">
    <span class="text-xl sm:text-2xl font-black tracking-tight text-[#EF4444] drop-shadow-[0_1px_8px_rgba(239,68,68,0.25)]">
      DELTALUM
    </span>
    <span class="mt-0.5 text-[9px] sm:text-[10px] font-bold tracking-[0.12em] text-slate-200 uppercase">
      Aluminio y Vidrio en General
    </span>
  </div>
</a>
