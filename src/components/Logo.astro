---
// Logo.astro — marca reutilizable (Navbar y Footer)
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class={`group/logo inline-flex items-center gap-2.5 ${className}`} aria-label="VIDRIERIA - Ir al inicio">
  <span class="grid h-9 w-9 place-items-center rounded-xl bg-linear-to-br from-cyan-400 to-blue-600 shadow-lg shadow-cyan-500/30 ring-1 ring-white/20 transition-transform duration-500 ease-premium group-hover/logo:rotate-6 group-hover/logo:scale-105">
    <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <rect x="4" y="3" width="16" height="18" rx="1.5" />
      <path d="M12 3v18M4 12h16" />
      <path d="M7 6.5l2.5 2.5" stroke-linecap="round" opacity="0.7" />
    </svg>
  </span>
  <span class="text-xl font-bold tracking-tight text-white">
    VIDRIE<span class="text-cyan-400">RIA</span>
  </span>
</a>
