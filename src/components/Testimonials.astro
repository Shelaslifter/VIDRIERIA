---
// Testimonials.astro
const testimonials = [
  {
    name: "Carlos Mendoza",
    role: "Arquitecto",
    quote: "Excelente calidad en los canceles de baño para nuestro último desarrollo residencial. Cumplieron en tiempo y forma, los acabados son impecables.",
    rating: 5
  },
  {
    name: "Laura Gutiérrez",
    role: "Propietaria",
    quote: "Remodelaron toda la fachada de mi casa con vidrio templado. El equipo fue muy profesional, limpio y el resultado superó mis expectativas.",
    rating: 5
  },
  {
    name: "Roberto Valdez",
    role: "Gerente de Local",
    quote: "Necesitaba vitrinas a medida para mi negocio y me ofrecieron la mejor opción costo-beneficio. Súper resistentes y con un diseño muy elegante.",
    rating: 5
  }
];
---

<section id="testimonios" class="py-24 bg-slate-900 text-white relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 z-0 opacity-20">
    <div class="absolute top-[-20%] left-[-10%] w-96 h-96 bg-cyan-600 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-[-20%] right-[-10%] w-96 h-96 bg-blue-600 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-base text-cyan-400 font-semibold tracking-wide uppercase">Testimonios</h2>
      <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-white sm:text-4xl">
        Lo que dicen nuestros clientes
      </p>
      <p class="mt-4 text-xl text-slate-300">
        La satisfacción de quienes confían en nosotros es nuestra mejor garantía.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((test) => (
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-3xl p-8 relative shadow-2xl hover:-translate-y-2 transition-transform duration-300">
          <!-- Quote Icon -->
          <div class="absolute top-6 right-6 text-cyan-400/30">
            <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
            </svg>
          </div>
          
          <!-- Stars -->
          <div class="flex space-x-1 mb-6">
            {[...Array(test.rating)].map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <p class="text-slate-200 text-lg italic mb-8 relative z-10">"{test.quote}"</p>
          
          <div>
            <h4 class="text-white font-bold text-lg">{test.name}</h4>
            <span class="text-cyan-400 text-sm">{test.role}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
