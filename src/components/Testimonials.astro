---
// Testimonials.astro
const testimonials = [
  {
    name: "Carlos Mendoza",
    role: "Arquitecto",
    quote: "Excelente calidad en los canceles de baño para nuestro último desarrollo residencial. Cumplieron en tiempo y forma, los acabados son impecables.",
    rating: 5
  },
  {
    name: "Laura Gutiérrez",
    role: "Propietaria",
    quote: "Remodelaron toda la fachada de mi casa con vidrio templado. El equipo fue muy profesional, limpio y el resultado superó mis expectativas.",
    rating: 5
  },
  {
    name: "Roberto Valdez",
    role: "Gerente de Local",
    quote: "Necesitaba vitrinas a medida para mi negocio y me ofrecieron la mejor opción costo-beneficio. Súper resistentes y con un diseño muy elegante.",
    rating: 5
  }
];
---

<section id="testimonios" class="relative overflow-hidden bg-slate-950 py-16 md:py-20 scroll-mt-24">
  <!-- Decoración de fondo premium -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div class="absolute -top-24 left-1/4 h-96 w-96 rounded-full bg-cyan-500/10 blur-[120px]"></div>
    <div class="absolute bottom-0 right-1/4 h-96 w-96 rounded-full bg-blue-600/10 blur-[120px]"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-white/5 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center md:mb-20">
      <span class="eyebrow text-cyan-400">Testimonios</span>
      <h2 class="section-title text-white">Lo que dicen nuestros clientes</h2>
      <p class="section-lead text-slate-400">
        La satisfacción de quienes confían en nosotros es nuestra mejor garantía. Descubre sus experiencias.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {testimonials.map((test) => (
        <article class="group relative flex flex-col rounded-3xl border border-white/10 bg-white/5 p-8 transition-all duration-500 ease-premium hover:-translate-y-2 hover:bg-white/10 hover:border-white/20 hover:shadow-2xl hover:shadow-cyan-900/20 backdrop-blur-md">
          
          <!-- Quote Icon -->
          <div class="absolute right-8 top-8 text-white/5 transition-colors duration-500 ease-premium group-hover:text-cyan-400/10">
            <svg class="h-14 w-14" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
            </svg>
          </div>
          
          <!-- Stars -->
          <div class="mb-6 flex gap-1">
            {[...Array(test.rating)].map(() => (
              <svg class="h-5 w-5 text-cyan-400 drop-shadow-[0_0_8px_rgba(34,211,238,0.5)]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <p class="relative z-10 mb-8 flex-1 text-lg italic leading-relaxed text-slate-300">
            "{test.quote}"
          </p>
          
          <div class="mt-auto flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-linear-to-br from-cyan-500 to-blue-600 text-lg font-bold text-white shadow-lg shadow-cyan-500/20">
              {test.name.charAt(0)}
            </div>
            <div>
              <h4 class="text-base font-bold text-white">{test.name}</h4>
              <span class="text-sm font-medium text-cyan-400">{test.role}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
