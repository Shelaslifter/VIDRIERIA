---
// Services.astro
interface Service {
  title: string;
  description: string;
  icon: string;
}

const iconClass = 'h-7 w-7 text-cyan-600 transition-colors duration-500 group-hover:text-white';

const services: Service[] = [
  {
    title: "Fabricación",
    description: "Diseño y manufactura a medida de cristal templado y aluminio para adaptarse perfectamente a las necesidades de tu proyecto.",
    icon: `<svg class="${iconClass}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>`
  },
  {
    title: "Instalación",
    description: "Proceso en sitio con altos estándares de seguridad, garantizando acabados impecables y duraderos en cada trabajo.",
    icon: `<svg class="${iconClass}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`
  },
  {
    title: "Mantenimiento",
    description: "Reparaciones, ajustes de cancelería, reemplazo de herrajes y sellado para prolongar la vida útil de tus instalaciones.",
    icon: `<svg class="${iconClass}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`
  }
];
---

<section id="servicios" class="relative py-16 md:py-20 scroll-mt-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center md:mb-20">
      <span class="eyebrow text-cyan-600">Nuestros Servicios</span>
      <h2 class="section-title text-slate-900">Soluciones integrales en cristal y aluminio</h2>
      <p class="section-lead">
        Brindamos un servicio completo desde la concepción de la idea hasta el mantenimiento de sus instalaciones.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
      {services.map((service, index) => (
        <article class="glass group relative flex flex-col overflow-hidden rounded-3xl p-8 transition-all duration-500 ease-premium hover:-translate-y-2 hover:bg-white/80 hover:shadow-2xl hover:shadow-cyan-900/10 lg:p-10">
          <!-- Línea de luz superior en hover -->
          <div class="absolute inset-x-8 top-0 h-px bg-linear-to-r from-transparent via-cyan-400 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
          <!-- Número decorativo -->
          <span class="absolute right-8 top-8 text-5xl font-bold tracking-tight text-slate-900/5 transition-colors duration-500 group-hover:text-cyan-500/15" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>

          <div class="mb-8 grid h-16 w-16 place-items-center rounded-2xl bg-cyan-50 ring-1 ring-cyan-100 transition-all duration-500 ease-premium group-hover:scale-110 group-hover:bg-linear-to-br group-hover:from-cyan-500 group-hover:to-blue-600 group-hover:shadow-lg group-hover:shadow-cyan-500/30 group-hover:ring-transparent">
            <Fragment set:html={service.icon} />
          </div>

          <h3 class="text-xl font-bold tracking-tight text-slate-900">{service.title}</h3>
          <p class="mt-3 flex-1 leading-relaxed text-slate-600">{service.description}</p>

          <a href="/contacto" class="group/link mt-8 inline-flex items-center gap-2 text-sm font-semibold text-cyan-700 transition-colors duration-300 hover:text-cyan-600">
            Cotizar servicio
            <svg class="h-4 w-4 transition-transform duration-300 group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
