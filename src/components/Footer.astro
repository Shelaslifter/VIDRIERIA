---
// Footer.astro
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="relative z-20 border-t border-white/5 bg-slate-950 pb-8 pt-16">
  <!-- Glowing subtle line at top -->
  <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-cyan-500/20 to-transparent"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-16 grid grid-cols-1 gap-12 md:grid-cols-4 lg:gap-16">
      <!-- Brand & Description -->
      <div class="col-span-1 md:col-span-2">
        <Logo class="mb-6" />
        <p class="max-w-md text-base leading-relaxed text-slate-400">
          Especialistas en diseño, fabricación e instalación de vidrio templado y cancelería de aluminio a medida. Soluciones elegantes y seguras para transformar tus espacios.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="mb-6 text-sm font-semibold tracking-wider text-white uppercase">Enlaces Rápidos</h3>
        <ul class="space-y-4">
          <li><a href="/#inicio" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Inicio</a></li>
          <li><a href="/#servicios" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Servicios</a></li>
          <li><a href="/#proyectos" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Proyectos</a></li>
          <li><a href="/contacto" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Contacto</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="mb-6 text-sm font-semibold tracking-wider text-white uppercase">Contacto</h3>
        <ul class="space-y-4 text-slate-400">
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-sm">Av. Principal #123, Ciudad, Estado</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 shrink-0 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="text-sm">+52 1 55 1234 5678</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 shrink-0 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="text-sm">contacto@vidrieria.com</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-slate-500 sm:flex-row">
      <p>&copy; <span id="current-year">{year}</span> VIDRIERIA. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="transition-colors duration-300 ease-premium hover:text-cyan-400">Aviso de Privacidad</a>
        <a href="#" class="transition-colors duration-300 ease-premium hover:text-cyan-400">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Actualización dinámica del año
  const yearElement = document.getElementById('current-year');
  if (yearElement) {
    yearElement.textContent = new Date().getFullYear().toString();
  }
</script>
