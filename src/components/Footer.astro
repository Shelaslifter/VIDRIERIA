---
// Footer.astro
import Logo from './Logo.astro';
import { getSiteSettings } from '../lib/settings';

const settings = await getSiteSettings();
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-white/10 bg-slate-950 pt-16 pb-12 text-slate-300">
  <!-- Sutil brillo de fondo superior -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-cyan-400/30 to-transparent"></div>
  <div class="pointer-events-none absolute -top-24 left-1/2 h-48 w-96 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-[80px]"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 pb-12 md:grid-cols-4 lg:gap-12">
      <!-- Columna 1: Marca -->
      <div class="space-y-4 md:col-span-2">
        <Logo />
        <p class="max-w-sm text-sm leading-relaxed text-slate-400">
          Transformamos tus espacios con la máxima elegancia, seguridad y precisión en cancelería de aluminio y vidrio templado.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="mb-6 text-sm font-semibold tracking-wider text-white uppercase">Navegación</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/#inicio" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Inicio</a></li>
          <li><a href="/#servicios" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Servicios</a></li>
          <li><a href="/#cotizador" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Cotizador</a></li>
          <li><a href="/#proyectos" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Proyectos</a></li>
          <li><a href="/contacto" class="text-slate-400 transition-colors duration-300 ease-premium hover:text-cyan-400">Contacto</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="mb-6 text-sm font-semibold tracking-wider text-white uppercase">Contacto</h3>
        <ul class="space-y-4 text-slate-400">
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span id="footer-address" class="text-sm">{settings.address}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 shrink-0 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span id="footer-phone" class="text-sm">{settings.phone_display}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 shrink-0 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span id="footer-email" class="text-sm">{settings.email}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-sm text-slate-500 sm:flex-row">
      <p>&copy; <span id="current-year">{year}</span> VIDRIERIA. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="transition-colors duration-300 ease-premium hover:text-cyan-400">Aviso de Privacidad</a>
        <a href="#" class="transition-colors duration-300 ease-premium hover:text-cyan-400">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>

<script>
  import { supabase } from '../lib/supabase';
  async function syncFooterInfo() {
    try {
      const { data } = await supabase
        .from('site_settings')
        .select('key, value')
        .in('key', ['address', 'phone_display', 'email']);
      if (data && data.length > 0) {
        data.forEach((item: { key: string; value: string }) => {
          if (item.key === 'address') {
            const el = document.getElementById('footer-address');
            if (el) el.textContent = item.value;
          }
          if (item.key === 'phone_display') {
            const el = document.getElementById('footer-phone');
            if (el) el.textContent = item.value;
          }
          if (item.key === 'email') {
            const el = document.getElementById('footer-email');
            if (el) el.textContent = item.value;
          }
        });
      }
    } catch (e) {}
  }
  syncFooterInfo();
</script>
