---
// Navbar.astro
import Logo from './Logo.astro';

interface NavLink {
  label: string;
  href: string;
}

const links: NavLink[] = [
  { label: 'Inicio', href: '/#inicio' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Proyectos', href: '/#proyectos' },
  { label: 'Contacto', href: '/contacto' },
];
---

<header
  id="site-header"
  data-scrolled="false"
  class="group fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-slate-950/30 backdrop-blur-md backdrop-saturate-150 transition-all duration-500 ease-premium data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-slate-950/75 data-[scrolled=true]:shadow-2xl data-[scrolled=true]:shadow-black/20 data-[scrolled=true]:backdrop-blur-xl"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between transition-all duration-500 ease-premium group-data-[scrolled=true]:h-16">
      <Logo />

      <!-- Desktop Menu -->
      <nav class="hidden items-center gap-10 md:flex" aria-label="Principal">
        {links.map((link) => (
          <a
            href={link.href}
            class="relative py-2 text-sm font-medium text-slate-200 transition-colors duration-300 hover:text-white after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:rounded-full after:bg-cyan-400 after:transition-transform after:duration-300 after:ease-premium hover:after:scale-x-100"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA Desktop -->
      <div class="hidden md:block">
        <a href="/contacto" class="btn-primary group/btn px-6 py-2.5 text-sm">
          Cotizar Proyecto
          <svg class="h-4 w-4 transition-transform duration-300 group-hover/btn:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5-5 5M6 12h12" />
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-button"
        class="grid h-10 w-10 place-items-center rounded-xl border border-white/10 bg-white/5 text-white transition-colors duration-300 hover:bg-white/10 hover:text-cyan-300 md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Abrir menú principal</span>
        <svg id="icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-white/10 bg-slate-950/95 md:hidden">
    <nav class="space-y-1 px-6 pb-6 pt-3" aria-label="Móvil">
      {links.map((link) => (
        <a href={link.href} class="block rounded-xl px-4 py-3 text-base font-medium text-slate-200 transition-colors duration-300 hover:bg-white/5 hover:text-cyan-300">
          {link.label}
        </a>
      ))}
      <a href="/contacto" class="btn-primary mt-4 w-full py-3.5 text-base">Cotizar Proyecto</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  // Navbar más sólido y compacto al hacer scroll
  const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 24));
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
  };

  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>
