---
// BeforeAfter.astro
import { Image } from 'astro:assets';

// Imágenes temporales: reemplazar por fotos reales de un trabajo (antes / después)
const beforeImg = "https://images.unsplash.com/photo-1505691938895-1758d7feb511?q=80&w=1600&auto=format&fit=crop";
const afterImg = "https://images.unsplash.com/photo-1600566752355-35792bedcfea?q=80&w=1600&auto=format&fit=crop";

const labelClass = "pointer-events-none absolute top-4 z-10 rounded-full border border-white/20 bg-slate-950/50 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-md";
---

<section class="relative py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center md:mb-20">
      <span class="eyebrow text-cyan-600">Transformación Total</span>
      <h2 class="section-title text-slate-900">El poder del cristal en tus espacios</h2>
      <p class="section-lead">Desliza para ver la diferencia que hace una instalación profesional.</p>
    </div>

    <div class="ba-slider group relative aspect-[4/3] w-full select-none overflow-hidden rounded-3xl bg-slate-200 shadow-2xl shadow-slate-900/15 ring-1 ring-slate-900/5 md:aspect-[16/9]">
      <!-- Después (base) -->
      <Image
        src={afterImg}
        alt="Después de la instalación"
        width={1600}
        height={900}
        class="pointer-events-none absolute inset-0 h-full w-full object-cover"
      />
      <span class={`${labelClass} right-4`}>Después</span>

      <!-- Antes (recortado con clip-path) -->
      <div class="ba-before absolute inset-0 z-20" style="clip-path: inset(0 50% 0 0);">
        <Image
          src={beforeImg}
          alt="Antes de la instalación"
          width={1600}
          height={900}
          class="pointer-events-none absolute inset-0 h-full w-full object-cover saturate-[.6] sepia-[.35]"
        />
        <span class={`${labelClass} left-4`}>Antes</span>
      </div>

      <!-- Divisor y manija -->
      <div class="ba-handle pointer-events-none absolute inset-y-0 z-30 w-0.5 -translate-x-1/2 bg-white/90 shadow-[0_0_20px_rgba(0,0,0,0.35)]" style="left: 50%;">
        <div class="absolute left-1/2 top-1/2 grid h-12 w-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-white/60 bg-white/80 text-slate-800 shadow-xl backdrop-blur-md transition-all duration-300 ease-premium group-hover:scale-110 group-hover:text-cyan-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7l-5 5 5 5M16 7l5 5-5 5" />
          </svg>
        </div>
      </div>

      <!-- Control accesible (invisible) -->
      <input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Comparar antes y después"
        class="ba-range absolute inset-0 z-40 h-full w-full cursor-ew-resize opacity-0"
      />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.ba-slider').forEach((slider) => {
    const range = slider.querySelector<HTMLInputElement>('.ba-range');
    const before = slider.querySelector<HTMLElement>('.ba-before');
    const handle = slider.querySelector<HTMLElement>('.ba-handle');
    if (!range || !before || !handle) return;

    const update = () => {
      const pos = Number(range.value);
      before.style.clipPath = `inset(0 ${100 - pos}% 0 0)`;
      handle.style.left = `${pos}%`;
    };

    range.addEventListener('input', update);
    update();
  });
</script>
