---
// Process.astro - Proceso de trabajo paso a paso
interface Step {
  step: string;
  title: string;
  description: string;
  highlight: string;
  icon: string;
}

const steps: Step[] = [
  {
    step: "01",
    title: "Asesoría y Cotización",
    description: "Nos cuentas tu idea por WhatsApp o formulario. Te asesoramos sobre calibres, acabados y te enviamos un presupuesto preliminar sin compromiso.",
    highlight: "Respuesta en menos de 2 horas",
    icon: `<svg class="h-6 w-6 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>`
  },
  {
    step: "02",
    title: "Levantamiento en Sitio",
    description: "Un técnico acude a tu domicilio para rectificar medidas milimétricas con láser, revisar desniveles y asegurar que la instalación quede perfecta.",
    highlight: "Toma de medidas profesional",
    icon: `<svg class="h-6 w-6 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>`
  },
  {
    step: "03",
    title: "Manufactura a Medida",
    description: "Procesamos los cristales en planta: corte, canteado plano brillante, barrenado para herrajes y proceso de templado térmico bajo norma de seguridad.",
    highlight: "Templado certificado",
    icon: `<svg class="h-6 w-6 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`
  },
  {
    step: "04",
    title: "Instalación y Garantía",
    description: "Montamos el proyecto de forma limpia, aplicamos sellador estructural anti-hongos, realizamos pruebas de ajuste y te entregamos tu garantía por escrito.",
    highlight: "Sellado y ajuste impecable",
    icon: `<svg class="h-6 w-6 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  }
];
---

<section id="proceso" class="relative py-16 md:py-20 overflow-hidden bg-slate-900 text-white">
  <!-- Luces decorativas oscuras -->
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <div class="absolute top-0 right-1/4 h-96 w-96 rounded-full bg-cyan-500/10 blur-[120px]"></div>
    <div class="absolute bottom-0 left-1/4 h-96 w-96 rounded-full bg-blue-600/10 blur-[120px]"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-cyan-400/20 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center md:mb-20">
      <span class="eyebrow text-cyan-400">Paso a Paso Transparente</span>
      <h2 class="section-title text-white">¿Cómo trabajamos tu proyecto?</h2>
      <p class="section-lead text-slate-400">
        Sin sorpresas ni complicaciones. Te acompañamos desde el primer mensaje hasta la entrega final de tu obra.
      </p>
    </div>

    <!-- Grid de pasos -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {steps.map((item, index) => (
        <div class="group relative flex flex-col justify-between rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-md transition-all duration-500 ease-premium hover:-translate-y-2 hover:border-cyan-400/30 hover:bg-white/10 hover:shadow-2xl hover:shadow-cyan-950/40">
          
          <!-- Encabezado de la tarjeta -->
          <div>
            <div class="mb-6 flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-500/10 ring-1 ring-cyan-400/20 transition-all duration-500 group-hover:scale-110 group-hover:bg-cyan-500 group-hover:text-white">
                <Fragment set:html={item.icon} />
              </span>
              <span class="font-mono text-3xl font-extrabold text-white/20 transition-colors duration-500 group-hover:text-cyan-400/50">
                {item.step}
              </span>
            </div>

            <h3 class="text-xl font-bold tracking-tight text-white mb-3">
              {item.title}
            </h3>

            <p class="text-sm leading-relaxed text-slate-300">
              {item.description}
            </p>
          </div>

          <!-- Badge inferior -->
          <div class="mt-8 pt-4 border-t border-white/5">
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400">
              <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
              {item.highlight}
            </span>
          </div>

        </div>
      ))}
    </div>

    <!-- CTA directo al final del proceso -->
    <div class="mt-14 text-center">
      <a href="#cotizador" class="btn-primary inline-flex px-8 py-4 text-sm font-bold">
        <span>Comenzar con el Paso 1 (Cotizar)</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>

  </div>
</section>
