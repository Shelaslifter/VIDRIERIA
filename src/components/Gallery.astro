---
// Gallery.astro
const categories = ["Todos", "Vidrio Templado", "Ventanas", "Domos", "Barandales"];

const projects = [
  { id: 1, category: "Vidrio Templado", image: "https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?q=80&w=1000&auto=format&fit=crop", title: "Fachada Comercial" },
  { id: 2, category: "Ventanas", image: "https://images.unsplash.com/photo-1600607688969-a5bfcd64bd28?q=80&w=1000&auto=format&fit=crop", title: "Ventanas Panorámicas Residenciales" },
  { id: 3, category: "Barandales", image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1000&auto=format&fit=crop", title: "Barandal de Escalera Interior" },
  { id: 4, category: "Domos", image: "https://images.unsplash.com/photo-1600566752355-35792bedcfea?q=80&w=1000&auto=format&fit=crop", title: "Domo Tragaluz Moderno" },
  { id: 5, category: "Vidrio Templado", image: "https://images.unsplash.com/photo-1600573472591-ee6b68d14c68?q=80&w=1000&auto=format&fit=crop", title: "Divisiones de Oficina" },
  { id: 6, category: "Barandales", image: "https://images.unsplash.com/photo-1600607686527-6fb886090705?q=80&w=1000&auto=format&fit=crop", title: "Balcón con Cristal Templado" },
];
---

<section id="proyectos" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 reveal">
      <h2 class="text-base text-cyan-600 font-semibold tracking-wide uppercase">Nuestro Trabajo</h2>
      <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Catálogo de Proyectos
      </p>
      <p class="mt-4 text-xl text-slate-500">
        Explora la calidad y detalle de nuestros últimos trabajos realizados.
      </p>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap justify-center gap-2 mb-12 reveal reveal-delay-100">
      {categories.map((cat, index) => (
        <button 
          class={`filter-btn px-6 py-2 rounded-full text-sm font-medium transition-colors border ${index === 0 ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-600 border-slate-200 hover:border-cyan-500 hover:text-cyan-600'}`}
          data-filter={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="gallery-grid">
      {projects.map((project, i) => (
        <div class={`gallery-item group relative rounded-2xl overflow-hidden cursor-pointer shadow-sm hover:shadow-xl transition-all duration-300 aspect-[4/3] reveal ${i % 3 === 0 ? '' : i % 3 === 1 ? 'reveal-delay-100' : 'reveal-delay-200'}`} data-category={project.category}>
          <img 
            src={project.image} 
            alt={project.title} 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
            <span class="text-cyan-300 text-sm font-semibold tracking-wider uppercase mb-1 block">{project.category}</span>
            <h3 class="text-white text-xl font-bold">{project.title}</h3>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button state
      filterBtns.forEach(b => {
        b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
      });
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
      btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900');

      const filterValue = btn.getAttribute('data-filter');

      galleryItems.forEach(item => {
        const category = item.getAttribute('data-category');
        // @ts-ignore
        if (filterValue === 'Todos' || filterValue === category) {
          item.classList.remove('hidden');
          setTimeout(() => {
            item.classList.remove('opacity-0', 'scale-95');
          }, 50);
        } else {
          item.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            item.classList.add('hidden');
          }, 300);
        }
      });
    });
  });
</script>
