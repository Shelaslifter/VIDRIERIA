---
// Gallery.astro
import { Image } from 'astro:assets';
import projectsData from '../data/portfolio.json';
import contactData from '../data/contact.json';
import { supabase, normalizeProject, type ProjectItem } from '../lib/supabase';

const categories = ["Todos", "Vidrio Templado", "Ventanas", "Domos", "Barandales"];

let projects: ProjectItem[] = projectsData.map(normalizeProject);

try {
  const { data, error } = await supabase
    .from('projects')
    .select('*')
    .order('created_at', { ascending: false });

  if (!error && data && data.length > 0) {
    projects = data.map(normalizeProject);
  }
} catch (e) {
  projects = projectsData.map(normalizeProject);
}
---

<section id="proyectos" class="relative py-16 md:py-20 scroll-mt-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-3xl text-center md:mb-20">
      <span class="eyebrow text-cyan-600">Nuestro Trabajo</span>
      <h2 class="section-title text-slate-900">Catálogo de Proyectos</h2>
      <p class="section-lead">
        Explora la calidad y detalle de nuestros últimos trabajos realizados. Haz clic en cualquiera para ver su galería de fotos, medidas, especificaciones y cotizar uno similar.
      </p>
    </div>

    <!-- Filters -->
    <div class="mb-12 flex flex-wrap justify-center gap-3">
      {categories.map((cat, index) => (
        <button 
          class={`filter-btn rounded-full px-6 py-2.5 text-sm font-semibold transition-all duration-300 ease-premium border cursor-pointer ${index === 0 ? 'bg-slate-900 text-white border-slate-900 shadow-md shadow-slate-900/20' : 'bg-white text-slate-600 border-slate-200 hover:border-cyan-500 hover:text-cyan-600 hover:shadow-sm'}`}
          data-filter={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Grid con altura mínima para evitar que la pantalla se colapse hacia testimonios -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8 min-h-[480px] transition-all duration-500" id="gallery-grid">
      {projects.map((project) => {
        const imageList = project.images && project.images.length > 0 ? project.images : [project.image];
        return (
          <div 
            class="gallery-item group relative aspect-[4/3] overflow-hidden rounded-3xl bg-slate-100 cursor-pointer shadow-sm transition-all duration-500 ease-premium hover:-translate-y-1 hover:shadow-2xl hover:shadow-slate-900/20" 
            data-category={project.category}
            data-title={project.title}
            data-image={project.image}
            data-images={JSON.stringify(imageList)}
            data-desc={project.description || "Proyecto diseñado y fabricado con cristales templados y cancelería de aluminio de alta resistencia."}
            data-specs={project.specs || "Vidrio de Seguridad • Herrajes Premium • Instalación Garantizada"}
            data-dimensions={project.dimensions || "Fabricación a medida exacta en obra"}
            role="button"
            tabindex="0"
            aria-label={`Ver detalles de ${project.title}`}
          >
            <Image 
              src={project.image} 
              alt={project.title} 
              width={1000}
              height={750}
              class="h-full w-full object-cover transition-transform duration-700 ease-premium group-hover:scale-105"
            />
            <!-- Overlay -->
            <div class="absolute inset-0 bg-linear-to-t from-slate-950/90 via-slate-950/40 to-transparent opacity-0 transition-opacity duration-500 ease-premium group-hover:opacity-100"></div>
            
            <!-- Contador de fotos si tiene varias -->
            {imageList.length > 1 && (
              <div class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-slate-950/65 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur-md border border-white/15">
                <svg class="h-3.5 w-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>{imageList.length} fotos</span>
              </div>
            )}

            <!-- Lupa / Icono de vista rápida -->
            <div class="absolute right-5 top-5 grid h-10 w-10 place-items-center rounded-full bg-white/20 text-white backdrop-blur-md opacity-0 transition-all duration-300 ease-premium group-hover:opacity-100 group-hover:scale-110">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
              </svg>
            </div>

            <!-- Content -->
            <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-8 text-left transition-transform duration-500 ease-premium">
              <div class="translate-y-8 opacity-0 transition-all duration-500 ease-premium group-hover:translate-y-0 group-hover:opacity-100">
                <span class="mb-2.5 inline-block rounded-full bg-cyan-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cyan-300 backdrop-blur-md border border-cyan-400/20">
                  {project.category}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">{project.title}</h3>
                <p class="mt-1.5 text-xs text-slate-300 line-clamp-1">Click para ver fotos, medidas y cotizar</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Lightbox Modal (Totalmente responsivo con Carrusel + Miniaturas + Medidas) -->
  <div 
    id="gallery-modal" 
    class="fixed inset-0 z-[9999] flex items-center justify-center p-2.5 sm:p-4 md:p-6 opacity-0 pointer-events-none transition-all duration-300 ease-premium overflow-y-auto"
    aria-hidden="true"
    role="dialog"
  >
    <!-- Backdrop con desenfoque profundo -->
    <div id="modal-backdrop" class="absolute inset-0 bg-slate-950/85 backdrop-blur-xl transition-opacity duration-300"></div>

    <!-- Contenedor del Modal con altura máxima y scroll interno -->
    <div 
      class="relative z-10 flex w-full max-w-5xl max-h-[92vh] flex-col md:flex-row overflow-hidden rounded-3xl sm:rounded-[2rem] border border-white/20 bg-slate-900 shadow-2xl shadow-cyan-950/50 backdrop-blur-2xl text-white transition-all duration-300 scale-95" 
      id="modal-container"
    >
      
      <!-- Botón Cerrar (Siempre visible en la esquina superior derecha) -->
      <button 
        id="modal-close" 
        class="absolute right-3.5 top-3.5 z-40 grid h-9 w-9 place-items-center rounded-full bg-slate-950/80 text-white/90 hover:bg-slate-900 hover:text-white transition-all border border-white/20 backdrop-blur-md cursor-pointer shadow-lg hover:scale-105"
        aria-label="Cerrar modal"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Columna 1: Visor de Imagen Principal + Flechas + Tira de Miniaturas Abajo -->
      <div class="relative flex flex-col md:w-[54%] shrink-0 bg-slate-950 border-b md:border-b-0 md:border-r border-white/10">
        
        <!-- Escenario Principal de la Foto -->
        <div id="modal-stage" class="relative h-56 sm:h-72 md:h-auto md:flex-1 min-h-[220px] md:min-h-[380px] overflow-hidden bg-slate-950 select-none">
          <img 
            id="modal-img" 
            src="" 
            alt="Detalle del proyecto" 
            class="h-full w-full object-cover transition-all duration-300 ease-out"
          />

          <!-- Contador de foto (Ej: 1 / 3) -->
          <div 
            id="modal-counter" 
            class="hidden absolute left-3.5 top-3.5 z-20 rounded-full bg-slate-950/75 px-3 py-1 text-[11px] font-bold tracking-wider text-white backdrop-blur-md border border-white/15 shadow-md"
          >
            1 / 1
          </div>

          <!-- Flecha Anterior -->
          <button
            type="button"
            id="modal-prev"
            class="hidden absolute left-3 top-1/2 -translate-y-1/2 z-20 grid h-9 w-9 sm:h-10 sm:w-10 place-items-center rounded-full bg-slate-950/75 text-white hover:bg-cyan-500 hover:border-cyan-400 border border-white/20 backdrop-blur-md transition-all cursor-pointer shadow-lg active:scale-95"
            aria-label="Foto anterior"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Flecha Siguiente -->
          <button
            type="button"
            id="modal-next"
            class="hidden absolute right-3 top-1/2 -translate-y-1/2 z-20 grid h-9 w-9 sm:h-10 sm:w-10 place-items-center rounded-full bg-slate-950/75 text-white hover:bg-cyan-500 hover:border-cyan-400 border border-white/20 backdrop-blur-md transition-all cursor-pointer shadow-lg active:scale-95"
            aria-label="Foto siguiente"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <!-- Tira de Miniaturas (Thumbnails) para saltar rápidamente entre fotos -->
        <div 
          id="modal-thumbs-bar" 
          class="hidden items-center justify-center gap-2.5 px-3 py-2.5 sm:px-4 sm:py-3 bg-slate-950/95 border-t border-white/10 overflow-x-auto no-scrollbar shrink-0"
        >
          <!-- Miniaturas generadas dinámicamente -->
        </div>
      </div>

      <!-- Columna 2: Info, Ficha Técnica, Medidas y Botones con scroll interno -->
      <div class="flex flex-col justify-between p-4 sm:p-6 lg:p-7 overflow-y-auto flex-1 overscroll-contain">
        <div class="space-y-3.5 sm:space-y-4">
          <!-- Categoría -->
          <div class="flex items-center gap-2 pr-8">
            <span id="modal-cat" class="inline-block rounded-full bg-cyan-500/20 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-cyan-300 border border-cyan-400/25">
              Categoría
            </span>
            <span class="inline-flex items-center gap-1 rounded-full bg-amber-400/10 px-2.5 py-1 text-[10px] font-bold text-amber-300 border border-amber-400/20">
              ★ Calidad Eurovent
            </span>
          </div>

          <!-- Título -->
          <h3 id="modal-title" class="text-xl sm:text-2xl font-bold tracking-tight text-white">
            Título del proyecto
          </h3>

          <!-- Descripción -->
          <p id="modal-desc" class="text-xs sm:text-sm leading-relaxed text-slate-300">
            Descripción completa del trabajo realizado.
          </p>

          <!-- Bloque de Ficha Técnica + Medidas del Proyecto -->
          <div class="space-y-2.5 pt-1">
            <!-- Ficha Técnica -->
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-3.5 sm:p-4">
              <h4 class="text-[11px] font-bold uppercase tracking-wider text-cyan-400 mb-1 flex items-center gap-1.5">
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Ficha Técnica y Materiales
              </h4>
              <p id="modal-specs" class="text-xs sm:text-[13px] text-slate-200 leading-relaxed">
                Especificaciones
              </p>
            </div>

            <!-- Medidas empleadas en el proyecto -->
            <div id="modal-dimensions-box" class="rounded-2xl border border-cyan-500/20 bg-cyan-500/[0.06] p-3.5 sm:p-4">
              <h4 class="text-[11px] font-bold uppercase tracking-wider text-cyan-300 mb-1 flex items-center gap-1.5">
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
                Medidas Realizadas en este Proyecto
              </h4>
              <p id="modal-dimensions" class="text-xs sm:text-[13px] font-semibold text-white">
                Fabricación a medida exacta en obra
              </p>
            </div>

            <!-- Sellos rápidos de Garantía y Medición -->
            <div class="grid grid-cols-2 gap-2 pt-0.5">
              <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-[11px] text-slate-300">
                <svg class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>1 Año de Garantía</span>
              </div>
              <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2 text-[11px] text-slate-300">
                <svg class="h-4 w-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span>Medición sin costo</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Botones de Acción (Siempre visibles en la parte inferior) -->
        <div class="shrink-0 flex flex-col sm:flex-row gap-2.5 pt-4 border-t border-white/10 mt-4">
          <a 
            id="modal-wa-btn" 
            data-wa-number={contactData.whatsappNumber}
            href="#" 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-primary flex-1 justify-center py-3 text-xs sm:text-sm font-semibold cursor-pointer shadow-lg shadow-cyan-500/20"
          >
            <span>Quiero uno similar</span>
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.815 11.815 0 018.413 3.487 11.821 11.821 0 013.48 8.413c-.003 6.558-5.339 11.893-11.893 11.893h-.005a11.882 11.882 0 01-5.683-1.448L.057 24z"/>
            </svg>
          </a>
          <a 
            href="#cotizador" 
            id="modal-calc-btn"
            class="btn-ghost justify-center py-3 text-xs sm:text-sm font-semibold cursor-pointer"
          >
            Calcular medidas
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { supabase, normalizeProject } from '../lib/supabase';

  // Filter logic
  const filterBtns = document.querySelectorAll('.filter-btn');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'shadow-md', 'shadow-slate-900/20');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
        b.classList.remove('hover:border-cyan-500', 'hover:text-cyan-600', 'hover:shadow-sm');
      });
      
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
      btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'shadow-md', 'shadow-slate-900/20');

      filterBtns.forEach(b => {
        if (b !== btn) {
           b.classList.add('hover:border-cyan-500', 'hover:text-cyan-600', 'hover:shadow-sm');
        }
      });

      const filterValue = btn.getAttribute('data-filter') || 'Todos';

      const currentItems = document.querySelectorAll<HTMLElement>('.gallery-item');
      currentItems.forEach(item => {
        const category = item.getAttribute('data-category');
        if (filterValue === 'Todos' || filterValue === category) {
          item.classList.remove('hidden');
          setTimeout(() => {
            item.classList.remove('opacity-0', 'scale-95');
          }, 10);
        } else {
          item.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            item.classList.add('hidden');
          }, 300);
        }
      });

      // Mantener la vista enfocada en la galería sin que la pantalla salte a Testimonios
      const section = document.getElementById('proyectos');
      if (section) {
        const navOffset = 90;
        const rect = section.getBoundingClientRect();
        if (rect.top < -20 || rect.top > 250) {
          const y = window.pageYOffset + rect.top - navOffset;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      }
    });
  });

  // Modal & Multi-image Carousel logic
  const modal = document.getElementById('gallery-modal');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const modalContainer = document.getElementById('modal-container');
  const modalClose = document.getElementById('modal-close');
  const modalStage = document.getElementById('modal-stage');
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalCounter = document.getElementById('modal-counter');
  const modalPrev = document.getElementById('modal-prev');
  const modalNext = document.getElementById('modal-next');
  const modalThumbsBar = document.getElementById('modal-thumbs-bar');
  const modalCat = document.getElementById('modal-cat');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalSpecs = document.getElementById('modal-specs');
  const modalDimensions = document.getElementById('modal-dimensions');
  const modalWaBtn = document.getElementById('modal-wa-btn') as HTMLAnchorElement;
  const modalCalcBtn = document.getElementById('modal-calc-btn') as HTMLAnchorElement;

  let currentImages: string[] = [];
  let currentIndex = 0;

  // Teletransportar el modal a document.body para liberarlo de cualquier transform o limitación de contenedor
  if (modal && modal.parentElement !== document.body) {
    document.body.appendChild(modal);
  }

  function renderCarouselState() {
    if (!modalImg || currentImages.length === 0) return;

    const targetUrl = currentImages[currentIndex] || currentImages[0];
    modalImg.style.opacity = '0.35';
    setTimeout(() => {
      modalImg.src = targetUrl;
      modalImg.style.opacity = '1';
    }, 90);

    const hasMultiple = currentImages.length > 1;

    if (modalCounter) {
      if (hasMultiple) {
        modalCounter.textContent = `${currentIndex + 1} / ${currentImages.length}`;
        modalCounter.classList.remove('hidden');
      } else {
        modalCounter.classList.add('hidden');
      }
    }

    if (modalPrev && modalNext) {
      if (hasMultiple) {
        modalPrev.classList.remove('hidden');
        modalPrev.classList.add('grid');
        modalNext.classList.remove('hidden');
        modalNext.classList.add('grid');
      } else {
        modalPrev.classList.add('hidden');
        modalPrev.classList.remove('grid');
        modalNext.classList.add('hidden');
        modalNext.classList.remove('grid');
      }
    }

    if (modalThumbsBar) {
      if (hasMultiple) {
        modalThumbsBar.classList.remove('hidden');
        modalThumbsBar.classList.add('flex');
        modalThumbsBar.innerHTML = currentImages
          .map(
            (imgUrl, idx) => `
            <button
              type="button"
              data-idx="${idx}"
              class="modal-thumb-btn relative h-12 w-16 sm:h-14 sm:w-20 shrink-0 overflow-hidden rounded-xl border-2 transition-all duration-200 cursor-pointer ${
                idx === currentIndex
                  ? 'border-cyan-400 ring-2 ring-cyan-400/40 scale-105 opacity-100'
                  : 'border-white/15 opacity-55 hover:opacity-90'
              }"
              aria-label="Ver imagen ${idx + 1}"
            >
              <img src="${imgUrl}" alt="Miniatura ${idx + 1}" class="h-full w-full object-cover" loading="lazy" />
            </button>
          `
          )
          .join('');

        modalThumbsBar.querySelectorAll<HTMLButtonElement>('.modal-thumb-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const idx = Number(btn.dataset.idx || 0);
            currentIndex = idx;
            renderCarouselState();
          });
        });
      } else {
        modalThumbsBar.classList.add('hidden');
        modalThumbsBar.classList.remove('flex');
        modalThumbsBar.innerHTML = '';
      }
    }
  }

  function showPrevImage(e?: Event) {
    e?.stopPropagation();
    if (currentImages.length <= 1) return;
    currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
    renderCarouselState();
  }

  function showNextImage(e?: Event) {
    e?.stopPropagation();
    if (currentImages.length <= 1) return;
    currentIndex = (currentIndex + 1) % currentImages.length;
    renderCarouselState();
  }

  modalPrev?.addEventListener('click', showPrevImage);
  modalNext?.addEventListener('click', showNextImage);

  // Soporte táctil (Swipe en móvil)
  let touchStartX = 0;
  modalStage?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  modalStage?.addEventListener('touchend', (e) => {
    const touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 40 && currentImages.length > 1) {
      if (diff > 0) {
        showNextImage();
      } else {
        showPrevImage();
      }
    }
  }, { passive: true });

  const openModal = (item: HTMLElement) => {
    const title = item.dataset.title || '';
    const cat = item.dataset.category || '';
    const img = item.dataset.image || '';
    const desc = item.dataset.desc || '';
    const specs = item.dataset.specs || '';
    const dimensions = item.dataset.dimensions || 'Fabricación a medida exacta en obra';

    let parsedImages: string[] = [];
    try {
      parsedImages = JSON.parse(item.dataset.images || '[]');
    } catch {
      parsedImages = [];
    }
    currentImages = parsedImages.length > 0 ? parsedImages : [img];
    currentIndex = 0;

    if (modalImg) modalImg.src = currentImages[0] || img;
    if (modalCat) modalCat.textContent = cat;
    if (modalTitle) modalTitle.textContent = title;
    if (modalDesc) modalDesc.textContent = desc;
    if (modalSpecs) modalSpecs.textContent = specs;
    if (modalDimensions) modalDimensions.textContent = dimensions;

    renderCarouselState();

    if (modalWaBtn) {
      const msg = `Hola Deltalum, vi el proyecto "${title}" (${cat} - ${dimensions}) en su página web y me gustaría cotizar algo similar.`;
      const waNum = modalWaBtn.dataset.waNumber || "524441353312";
      modalWaBtn.href = `https://wa.me/${waNum}?text=${encodeURIComponent(msg)}`;
    }

    if (modal) {
      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.setAttribute('aria-hidden', 'false');
      modalContainer?.classList.remove('scale-95');
      modalContainer?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }
  };

  const closeModal = () => {
    if (modal) {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.setAttribute('aria-hidden', 'true');
      modalContainer?.classList.add('scale-95');
      modalContainer?.classList.remove('scale-100');
      document.body.style.overflow = '';
    }
  };

  function attachGalleryListeners() {
    const items = document.querySelectorAll<HTMLElement>('.gallery-item');
    items.forEach(item => {
      item.onclick = () => openModal(item);
      item.onkeydown = (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(item);
        }
      };
    });
  }

  attachGalleryListeners();

  modalClose?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);
  modalCalcBtn?.addEventListener('click', closeModal);

  window.addEventListener('keydown', (e) => {
    if (!modal || modal.classList.contains('pointer-events-none')) return;
    if (e.key === 'Escape') {
      closeModal();
    } else if (e.key === 'ArrowLeft') {
      showPrevImage();
    } else if (e.key === 'ArrowRight') {
      showNextImage();
    }
  });

  // Sincronización en vivo con Supabase en el navegador
  async function syncLiveGallery() {
    const grid = document.getElementById('gallery-grid');
    if (!grid) return;

    try {
      const { data, error } = await supabase
        .from('projects')
        .select('*')
        .order('created_at', { ascending: false });

      if (!error && data && data.length > 0) {
        const normalizedList = data.map(normalizeProject);
        grid.innerHTML = normalizedList.map((project) => {
          const imgs = project.images && project.images.length > 0 ? project.images : [project.image];
          const safeImagesAttr = JSON.stringify(imgs).replace(/"/g, '&quot;');
          const countBadge = imgs.length > 1 ? `
            <div class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-slate-950/65 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur-md border border-white/15">
              <svg class="h-3.5 w-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>${imgs.length} fotos</span>
            </div>
          ` : '';

          return `
            <div 
              class="gallery-item group relative aspect-[4/3] overflow-hidden rounded-3xl bg-slate-100 cursor-pointer shadow-sm transition-all duration-500 ease-premium hover:-translate-y-1 hover:shadow-2xl hover:shadow-slate-900/20" 
              data-category="${project.category}"
              data-title="${project.title}"
              data-image="${project.image}"
              data-images="${safeImagesAttr}"
              data-desc="${project.description || 'Proyecto diseñado y fabricado con cristales templados y cancelería de aluminio de alta resistencia.'}"
              data-specs="${project.specs || 'Vidrio de Seguridad • Herrajes Premium • Instalación Garantizada'}"
              data-dimensions="${project.dimensions || 'Fabricación a medida exacta en obra'}"
              role="button"
              tabindex="0"
              aria-label="Ver detalles de ${project.title}"
            >
              <img 
                src="${project.image}" 
                alt="${project.title}" 
                class="h-full w-full object-cover transition-transform duration-700 ease-premium group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-slate-950/90 via-slate-950/40 to-transparent opacity-0 transition-opacity duration-500 ease-premium group-hover:opacity-100"></div>
              ${countBadge}
              <div class="absolute right-5 top-5 grid h-10 w-10 place-items-center rounded-full bg-white/20 text-white backdrop-blur-md opacity-0 transition-all duration-300 ease-premium group-hover:opacity-100 group-hover:scale-110">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>

              <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-8 text-left transition-transform duration-500 ease-premium">
                <div class="translate-y-8 opacity-0 transition-all duration-500 ease-premium group-hover:translate-y-0 group-hover:opacity-100">
                  <span class="mb-2.5 inline-block rounded-full bg-cyan-500/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cyan-300 backdrop-blur-md border border-cyan-400/20">
                    ${project.category}
                  </span>
                  <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">${project.title}</h3>
                  <p class="mt-1.5 text-xs text-slate-300 line-clamp-1">Click para ver fotos, medidas y cotizar</p>
                </div>
              </div>
            </div>
          `;
        }).join('');

        attachGalleryListeners();
      }
    } catch (e) {
      // Ignorar si no hay conexión
    }
  }

  syncLiveGallery();
</script>
