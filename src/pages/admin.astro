<script>
  import { supabase, type ProjectItem } from '../lib/supabase';
  import { DEFAULT_SETTINGS, type SiteSettings } from '../lib/settings';

  const ADMIN_PASSWORD = "admin123";

  // Elementos de Autenticación
  const authScreen = document.getElementById('auth-screen');
  const dashboardScreen = document.getElementById('dashboard-screen');
  const authForm = document.getElementById('auth-form');
  const adminPin = document.getElementById('admin-pin') as HTMLInputElement;
  const authError = document.getElementById('auth-error');
  const btnLogout = document.getElementById('btn-logout');
  const statusAlert = document.getElementById('status-alert');

  // Elementos de Tabs
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');

  // Elementos Pestaña 1: Proyectos
  const projectsGrid = document.getElementById('projects-grid');
  const projectsCount = document.getElementById('projects-count');
  const uploadModal = document.getElementById('upload-modal');
  const btnOpenModal = document.getElementById('btn-open-modal');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnCancelModal = document.getElementById('btn-cancel-modal');
  const modalBg = document.getElementById('modal-bg');
  const uploadForm = document.getElementById('upload-form') as HTMLFormElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
  const previewPlaceholder = document.getElementById('preview-placeholder');
  const previewContainer = document.getElementById('preview-container');
  const btnSubmit = document.getElementById('btn-submit-upload') as HTMLButtonElement;

  // Elementos Pestaña 2: Hero
  const heroPreviewImg = document.getElementById('hero-preview-img') as HTMLImageElement;
  const heroFileInput = document.getElementById('hero-file-input') as HTMLInputElement;
  const heroFileLabel = document.getElementById('hero-file-label');
  const heroUrlInput = document.getElementById('hero-url-input') as HTMLInputElement;
  const btnSaveHero = document.getElementById('btn-save-hero') as HTMLButtonElement;
  const btnRestoreHero = document.getElementById('btn-restore-hero') as HTMLButtonElement;

  // Elementos Pestaña 3: Antes y Después
  const adminBeforePreview = document.getElementById('admin-before-preview') as HTMLImageElement;
  const adminAfterPreview = document.getElementById('admin-after-preview') as HTMLImageElement;
  const adminBeforeClipper = document.getElementById('admin-before-clipper');
  const adminBaDivider = document.getElementById('admin-ba-divider');
  const adminBaRange = document.getElementById('admin-ba-range') as HTMLInputElement;
  const beforeFileInput = document.getElementById('before-file-input') as HTMLInputElement;
  const beforeFileLabel = document.getElementById('before-file-label');
  const beforeUrlInput = document.getElementById('before-url-input') as HTMLInputElement;
  const afterFileInput = document.getElementById('after-file-input') as HTMLInputElement;
  const afterFileLabel = document.getElementById('after-file-label');
  const afterUrlInput = document.getElementById('after-url-input') as HTMLInputElement;
  const btnSaveBeforeAfter = document.getElementById('btn-save-beforeafter') as HTMLButtonElement;
  const btnRestoreBeforeAfter = document.getElementById('btn-restore-beforeafter') as HTMLButtonElement;

  // Elementos Pestaña 4: Contacto y Mapa
  const contactForm = document.getElementById('contact-settings-form') as HTMLFormElement;
  const cfgWa = document.getElementById('cfg-wa') as HTMLInputElement;
  const cfgPhone = document.getElementById('cfg-phone') as HTMLInputElement;
  const cfgEmail = document.getElementById('cfg-email') as HTMLInputElement;
  const cfgAddress = document.getElementById('cfg-address') as HTMLInputElement;
  const cfgCity = document.getElementById('cfg-city') as HTMLInputElement;
  const cfgMap = document.getElementById('cfg-map') as HTMLTextAreaElement;
  const adminMapPreview = document.getElementById('admin-map-preview') as HTMLIFrameElement;
  const btnRestoreContact = document.getElementById('btn-restore-contact') as HTMLButtonElement;

  // ==========================================
  // 1. CONTROL DE SESIÓN
  // ==========================================
  const checkAuth = () => {
    const isAuth = sessionStorage.getItem('vidrieria_admin_auth') === 'true';
    if (isAuth) {
      authScreen?.classList.add('hidden');
      dashboardScreen?.classList.remove('hidden');
      btnLogout?.classList.remove('hidden');
      loadAllData();
    } else {
      authScreen?.classList.remove('hidden');
      dashboardScreen?.classList.add('hidden');
      btnLogout?.classList.add('hidden');
    }
  };

  authForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (adminPin.value === ADMIN_PASSWORD) {
      sessionStorage.setItem('vidrieria_admin_auth', 'true');
      authError?.classList.add('hidden');
      checkAuth();
    } else {
      authError?.classList.remove('hidden');
      adminPin.focus();
    }
  });

  btnLogout?.addEventListener('click', () => {
    sessionStorage.removeItem('vidrieria_admin_auth');
    checkAuth();
  });

  // ==========================================
  // 2. SISTEMA DE PESTAÑAS (TABS)
  // ==========================================
  function switchTab(targetTab: string) {
    tabButtons.forEach(btn => {
      const isTarget = btn.dataset.tab === targetTab;
      if (isTarget) {
        btn.classList.add('active', 'border-cyan-500/30', 'bg-cyan-500/20', 'text-cyan-300', 'ring-1', 'ring-cyan-500/20');
        btn.classList.remove('border-white/10', 'bg-white/5', 'text-slate-300');
      } else {
        btn.classList.remove('active', 'border-cyan-500/30', 'bg-cyan-500/20', 'text-cyan-300', 'ring-1', 'ring-cyan-500/20');
        btn.classList.add('border-white/10', 'bg-white/5', 'text-slate-300');
      }
    });

    tabPanes.forEach(pane => {
      if (pane.id === `tab-content-${targetTab}`) {
        pane.classList.remove('hidden');
      } else {
        pane.classList.add('hidden');
      }
    });
  }

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      if (tab) switchTab(tab);
    });
  });

  // Helper para alertas de feedback
  function showStatus(msg: string, type: 'success' | 'error' | 'warning') {
    if (!statusAlert) return;
    statusAlert.textContent = msg;
    statusAlert.classList.remove('hidden', 'bg-emerald-500/10', 'text-emerald-300', 'border-emerald-500/20', 'bg-rose-500/10', 'text-rose-300', 'border-rose-500/20', 'bg-amber-500/10', 'text-amber-300', 'border-amber-500/20');
    
    if (type === 'success') {
      statusAlert.classList.add('bg-emerald-500/10', 'text-emerald-300', 'border', 'border-emerald-500/20');
    } else if (type === 'error') {
      statusAlert.classList.add('bg-rose-500/10', 'text-rose-300', 'border', 'border-rose-500/20');
    } else {
      statusAlert.classList.add('bg-amber-500/10', 'text-amber-300', 'border', 'border-amber-500/20');
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });

    setTimeout(() => {
      statusAlert.classList.add('hidden');
    }, 6500);
  }

  // Helper para subir archivos a Supabase Storage
  async function uploadFileToStorage(file: File, folder: string): Promise<string> {
    const fileExt = file.name.split('.').pop();
    const fileName = `${folder}/${Date.now()}-${Math.random().toString(36).substring(2, 8)}.${fileExt}`;

    const { error } = await supabase.storage
      .from('portfolio')
      .upload(fileName, file, { cacheControl: '3600', upsert: false });

    if (error) {
      throw new Error(`Error en el almacén de fotos (${error.message}). Asegúrate de haber ejecutado el script SQL en Supabase.`);
    }

    const { data: urlData } = supabase.storage
      .from('portfolio')
      .getPublicUrl(fileName);

    return urlData.publicUrl;
  }

  // Helper para guardar una configuración en la tabla site_settings
  async function saveSetting(key: string, value: string) {
    const { error } = await supabase
      .from('site_settings')
      .upsert({ key, value, updated_at: new Date().toISOString() });

    if (error) {
      throw new Error(`Error al guardar '${key}': ${error.message}`);
    }
  }

  // ==========================================
  // 3. CARGA GLOBAL DE DATOS
  // ==========================================
  async function loadAllData() {
    await Promise.all([
      loadProjects(),
      loadSiteSettings()
    ]);
  }

  // Cargar Ajustes Generales
  async function loadSiteSettings() {
    try {
      const { data, error } = await supabase
        .from('site_settings')
        .select('key, value');

      const settingsMap: Record<string, string> = {};
      if (data && !error) {
        data.forEach((row: { key: string; value: string }) => {
          settingsMap[row.key] = row.value;
        });
      }

      const heroUrl = settingsMap.hero_bg || DEFAULT_SETTINGS.hero_bg;
      const beforeUrl = settingsMap.before_img || DEFAULT_SETTINGS.before_img;
      const afterUrl = settingsMap.after_img || DEFAULT_SETTINGS.after_img;
      const waVal = settingsMap.whatsapp_number || DEFAULT_SETTINGS.whatsapp_number;
      const phoneVal = settingsMap.phone_display || DEFAULT_SETTINGS.phone_display;
      const emailVal = settingsMap.email || DEFAULT_SETTINGS.email;
      const addressVal = settingsMap.address || DEFAULT_SETTINGS.address;
      const cityVal = settingsMap.city_state || DEFAULT_SETTINGS.city_state;
      const mapVal = settingsMap.map_embed_url || DEFAULT_SETTINGS.map_embed_url;

      // Actualizar Tab 2: Hero
      if (heroPreviewImg) heroPreviewImg.src = heroUrl;
      if (heroUrlInput) heroUrlInput.value = heroUrl;

      // Actualizar Tab 3: Antes y Después
      if (adminBeforePreview) adminBeforePreview.src = beforeUrl;
      if (adminAfterPreview) adminAfterPreview.src = afterUrl;
      if (beforeUrlInput) beforeUrlInput.value = beforeUrl;
      if (afterUrlInput) afterUrlInput.value = afterUrl;

      // Actualizar Tab 4: Contacto
      if (cfgWa) cfgWa.value = waVal;
      if (cfgPhone) cfgPhone.value = phoneVal;
      if (cfgEmail) cfgEmail.value = emailVal;
      if (cfgAddress) cfgAddress.value = addressVal;
      if (cfgCity) cfgCity.value = cityVal;
      if (cfgMap) cfgMap.value = mapVal;
      if (adminMapPreview) adminMapPreview.src = mapVal;

    } catch (err: any) {
      console.warn('Aviso al cargar ajustes:', err.message);
    }
  }

  // ==========================================
  // 4. PESTAÑA 1: PROYECTOS (LÓGICA)
  // ==========================================
  async function loadProjects() {
    if (!projectsGrid) return;
    try {
      const { data, error } = await supabase
        .from('projects')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        projectsGrid.innerHTML = `
          <div class="col-span-full rounded-2xl border border-amber-500/30 bg-amber-500/10 p-6 text-center text-amber-200">
            <p class="font-bold">⚠️ Falta crear las tablas en Supabase.</p>
            <p class="mt-2 text-xs text-amber-300">Copia y pega el script SQL en el editor de Supabase para activar la base de datos.</p>
          </div>
        `;
        return;
      }

      if (!data || data.length === 0) {
        if (projectsCount) projectsCount.textContent = '0 proyectos';
        projectsGrid.innerHTML = `
          <div class="col-span-full rounded-2xl border border-white/10 bg-white/5 py-16 text-center text-slate-400">
            <p class="text-base font-semibold">No hay proyectos subidos todavía.</p>
            <p class="mt-1 text-xs text-slate-500">Haz clic en "Subir Nuevo Proyecto" para agregar el primero.</p>
          </div>
        `;
        return;
      }

      if (projectsCount) projectsCount.textContent = `${data.length} proyectos activos`;

      projectsGrid.innerHTML = data.map((item: ProjectItem) => `
        <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 transition-all duration-300 hover:border-white/20 hover:bg-white/10" id="card-${item.id}">
          <div class="relative aspect-[4/3] overflow-hidden bg-slate-900">
            <img src="${item.image}" alt="${item.title}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <span class="absolute top-3 left-3 rounded-full bg-slate-950/70 px-3 py-1 text-xs font-semibold text-cyan-300 backdrop-blur-md border border-white/10">
              ${item.category}
            </span>
          </div>

          <div class="p-5">
            <h3 class="text-base font-bold text-white line-clamp-1 mb-1">${item.title}</h3>
            <p class="text-xs text-slate-400 line-clamp-2 mb-4">${item.description || 'Sin descripción'}</p>
            
            <div class="flex items-center justify-between pt-3 border-t border-white/10">
              <span class="text-[10px] text-slate-500 font-mono">ID: ${item.id}</span>
              <button 
                class="btn-delete text-xs font-semibold text-rose-400 hover:text-rose-300 flex items-center gap-1 transition-colors py-1 px-2 rounded-lg hover:bg-rose-500/10 cursor-pointer"
                data-id="${item.id}"
                data-title="${item.title}"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <span>Eliminar</span>
              </button>
            </div>
          </div>
        </div>
      `).join('');

      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = (btn as HTMLElement).dataset.id;
          const title = (btn as HTMLElement).dataset.title;
          if (confirm(`¿Estás seguro de que deseas eliminar el proyecto "${title}" de la página web?`)) {
            await deleteProject(id);
          }
        });
      });

    } catch (err: any) {
      showStatus(`Error al conectar con Supabase: ${err.message}`, 'error');
    }
  }

  async function deleteProject(id: string | undefined) {
    if (!id) return;
    try {
      const { error } = await supabase.from('projects').delete().eq('id', id);
      if (error) {
        showStatus(`Error al eliminar: ${error.message}`, 'error');
      } else {
        showStatus('Proyecto eliminado correctamente de la web.', 'success');
        loadProjects();
      }
    } catch (e: any) {
      showStatus(`Error inesperado: ${e.message}`, 'error');
    }
  }

  // Modal de Subida de Proyecto
  const openModal = () => {
    uploadModal?.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    uploadModal?.classList.add('opacity-0', 'pointer-events-none');
    uploadForm?.reset();
    previewContainer?.classList.add('hidden');
    previewPlaceholder?.classList.remove('hidden');
    document.body.style.overflow = '';
  };

  btnOpenModal?.addEventListener('click', openModal);
  btnCloseModal?.addEventListener('click', closeModal);
  btnCancelModal?.addEventListener('click', closeModal);
  modalBg?.addEventListener('click', closeModal);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && uploadModal && !uploadModal.classList.contains('pointer-events-none')) {
      closeModal();
    }
  });

  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        if (imagePreview && e.target?.result) {
          imagePreview.src = e.target.result as string;
          previewContainer?.classList.remove('hidden');
          previewPlaceholder?.classList.add('hidden');
        }
      };
      reader.readAsDataURL(file);
    }
  });

  uploadForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const file = fileInput.files?.[0];
    if (!file) {
      alert('Por favor selecciona una foto del trabajo.');
      return;
    }

    const titleInput = document.getElementById('p-title') as HTMLInputElement;
    const catInput = document.getElementById('p-category') as HTMLSelectElement;
    const specsInput = document.getElementById('p-specs') as HTMLInputElement;
    const descInput = document.getElementById('p-desc') as HTMLTextAreaElement;

    btnSubmit.disabled = true;
    btnSubmit.innerHTML = `
      <div class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-solid border-white border-r-transparent mr-2"></div>
      Subiendo imagen y guardando...
    `;

    try {
      const imageUrl = await uploadFileToStorage(file, 'proyectos');

      const { error: insertError } = await supabase.from('projects').insert([
        {
          title: titleInput.value.trim(),
          category: catInput.value,
          image: imageUrl,
          specs: specsInput.value.trim() || 'Vidrio Templado y Aluminio',
          description: descInput.value.trim() || ''
        }
      ]);

      if (insertError) {
        throw new Error(`Error al registrar en la base de datos: ${insertError.message}`);
      }

      closeModal();
      showStatus('¡Proyecto publicado exitosamente en el catálogo!', 'success');
      loadProjects();

    } catch (err: any) {
      alert(`No se pudo completar la subida: ${err.message}`);
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = `<span>Guardar y Publicar en la Web</span>`;
    }
  });

  // ==========================================
  // 5. PESTAÑA 2: PORTADA HERO (LÓGICA)
  // ==========================================
  heroFileInput?.addEventListener('change', () => {
    const file = heroFileInput.files?.[0];
    if (file) {
      if (heroFileLabel) heroFileLabel.textContent = `Archivo: ${file.name}`;
      const reader = new FileReader();
      reader.onload = (e) => {
        if (heroPreviewImg && e.target?.result) {
          heroPreviewImg.src = e.target.result as string;
        }
      };
      reader.readAsDataURL(file);
    }
  });

  heroUrlInput?.addEventListener('input', () => {
    const url = heroUrlInput.value.trim();
    if (url && heroPreviewImg) {
      heroPreviewImg.src = url;
    }
  });

  btnSaveHero?.addEventListener('click', async () => {
    const file = heroFileInput.files?.[0];
    let finalUrl = heroUrlInput.value.trim();

    if (!file && !finalUrl) {
      alert('Por favor selecciona una foto o introduce un enlace web para la portada.');
      return;
    }

    btnSaveHero.disabled = true;
    btnSaveHero.innerHTML = `
      <div class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-solid border-white border-r-transparent mr-2"></div>
      Guardando portada...
    `;

    try {
      if (file) {
        finalUrl = await uploadFileToStorage(file, 'site');
      }

      await saveSetting('hero_bg', finalUrl);
      if (heroPreviewImg) heroPreviewImg.src = finalUrl;
      if (heroUrlInput) heroUrlInput.value = finalUrl;
      showStatus('¡Foto de portada actualizada correctamente en el sitio web!', 'success');
    } catch (err: any) {
      showStatus(`Error al guardar portada: ${err.message}`, 'error');
    } finally {
      btnSaveHero.disabled = false;
      btnSaveHero.innerHTML = `<span>Guardar y Aplicar Portada</span>`;
    }
  });

  btnRestoreHero?.addEventListener('click', async () => {
    if (!confirm('¿Deseas restaurar la foto de portada predeterminada original?')) return;
    try {
      await saveSetting('hero_bg', DEFAULT_SETTINGS.hero_bg);
      if (heroPreviewImg) heroPreviewImg.src = DEFAULT_SETTINGS.hero_bg;
      if (heroUrlInput) heroUrlInput.value = DEFAULT_SETTINGS.hero_bg;
      if (heroFileLabel) heroFileLabel.textContent = 'Seleccionar foto de portada';
      if (heroFileInput) heroFileInput.value = '';
      showStatus('Portada predeterminada restaurada con éxito.', 'success');
    } catch (err: any) {
      showStatus(`Error al restaurar: ${err.message}`, 'error');
    }
  });

  // ==========================================
  // 6. PESTAÑA 3: ANTES Y DESPUÉS (LÓGICA)
  // ==========================================
  adminBaRange?.addEventListener('input', () => {
    const val = adminBaRange.value;
    if (adminBeforeClipper) adminBeforeClipper.style.width = `${val}%`;
    if (adminBaDivider) adminBaDivider.style.left = `${val}%`;
  });

  beforeFileInput?.addEventListener('change', () => {
    const file = beforeFileInput.files?.[0];
    if (file) {
      if (beforeFileLabel) beforeFileLabel.textContent = file.name;
      const reader = new FileReader();
      reader.onload = (e) => {
        if (adminBeforePreview && e.target?.result) {
          adminBeforePreview.src = e.target.result as string;
        }
      };
      reader.readAsDataURL(file);
    }
  });

  beforeUrlInput?.addEventListener('input', () => {
    const url = beforeUrlInput.value.trim();
    if (url && adminBeforePreview) adminBeforePreview.src = url;
  });

  afterFileInput?.addEventListener('change', () => {
    const file = afterFileInput.files?.[0];
    if (file) {
      if (afterFileLabel) afterFileLabel.textContent = file.name;
      const reader = new FileReader();
      reader.onload = (e) => {
        if (adminAfterPreview && e.target?.result) {
          adminAfterPreview.src = e.target.result as string;
        }
      };
      reader.readAsDataURL(file);
    }
  });

  afterUrlInput?.addEventListener('input', () => {
    const url = afterUrlInput.value.trim();
    if (url && adminAfterPreview) adminAfterPreview.src = url;
  });

  btnSaveBeforeAfter?.addEventListener('click', async () => {
    const bFile = beforeFileInput.files?.[0];
    const aFile = afterFileInput.files?.[0];
    let bUrl = beforeUrlInput.value.trim();
    let aUrl = afterUrlInput.value.trim();

    if (!bFile && !bUrl && !aFile && !aUrl) {
      alert('Por favor selecciona o introduce al menos una de las fotos para guardar.');
      return;
    }

    btnSaveBeforeAfter.disabled = true;
    btnSaveBeforeAfter.innerHTML = `
      <div class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-solid border-white border-r-transparent mr-2"></div>
      Guardando fotos de comparativa...
    `;

    try {
      if (bFile) {
        bUrl = await uploadFileToStorage(bFile, 'site');
      }
      if (aFile) {
        aUrl = await uploadFileToStorage(aFile, 'site');
      }

      if (bUrl) await saveSetting('before_img', bUrl);
      if (aUrl) await saveSetting('after_img', aUrl);

      if (bUrl && adminBeforePreview) adminBeforePreview.src = bUrl;
      if (aUrl && adminAfterPreview) adminAfterPreview.src = aUrl;

      showStatus('¡Fotos de Antes y Después guardadas correctamente en la web!', 'success');
    } catch (err: any) {
      showStatus(`Error al guardar: ${err.message}`, 'error');
    } finally {
      btnSaveBeforeAfter.disabled = false;
      btnSaveBeforeAfter.innerHTML = `<span>Guardar Ambas Fotos</span>`;
    }
  });

  btnRestoreBeforeAfter?.addEventListener('click', async () => {
    if (!confirm('¿Deseas restaurar las imágenes de Antes y Después predeterminadas?')) return;
    try {
      await saveSetting('before_img', DEFAULT_SETTINGS.before_img);
      await saveSetting('after_img', DEFAULT_SETTINGS.after_img);

      if (adminBeforePreview) adminBeforePreview.src = DEFAULT_SETTINGS.before_img;
      if (adminAfterPreview) adminAfterPreview.src = DEFAULT_SETTINGS.after_img;
      if (beforeUrlInput) beforeUrlInput.value = DEFAULT_SETTINGS.before_img;
      if (afterUrlInput) afterUrlInput.value = DEFAULT_SETTINGS.after_img;
      if (beforeFileLabel) beforeFileLabel.textContent = 'Subir foto Antes';
      if (afterFileLabel) afterFileLabel.textContent = 'Subir foto Después';
      if (beforeFileInput) beforeFileInput.value = '';
      if (afterFileInput) afterFileInput.value = '';

      showStatus('Fotos predeterminadas de Antes y Después restauradas.', 'success');
    } catch (err: any) {
      showStatus(`Error al restaurar: ${err.message}`, 'error');
    }
  });

  // ==========================================
  // 7. PESTAÑA 4: CONTACTO Y MAPA (LÓGICA)
  // ==========================================
  cfgMap?.addEventListener('input', () => {
    let url = cfgMap.value.trim();
    // Si el usuario pegó el iframe completo (<iframe src="..."), extraer automáticamente el enlace src
    if (url.includes('<iframe') && url.includes('src="')) {
      const match = url.match(/src="([^"]+)"/);
      if (match && match[1]) {
        url = match[1];
        cfgMap.value = url;
      }
    }
    if (adminMapPreview && url) {
      adminMapPreview.src = url;
    }
  });

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    let mapUrl = cfgMap.value.trim();
    if (mapUrl.includes('<iframe') && mapUrl.includes('src="')) {
      const match = mapUrl.match(/src="([^"]+)"/);
      if (match && match[1]) {
        mapUrl = match[1];
        cfgMap.value = mapUrl;
      }
    }

    const btn = document.getElementById('btn-save-contact') as HTMLButtonElement;
    btn.disabled = true;
    btn.innerHTML = `
      <div class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-solid border-white border-r-transparent mr-2"></div>
      Guardando información...
    `;

    try {
      await Promise.all([
        saveSetting('whatsapp_number', cfgWa.value.trim()),
        saveSetting('phone_display', cfgPhone.value.trim()),
        saveSetting('email', cfgEmail.value.trim()),
        saveSetting('address', cfgAddress.value.trim()),
        saveSetting('city_state', cfgCity.value.trim()),
        saveSetting('map_embed_url', mapUrl)
      ]);

      if (adminMapPreview) adminMapPreview.src = mapUrl;
      showStatus('¡Datos de contacto, teléfonos y mapa actualizados con éxito en todo el sitio web!', 'success');
    } catch (err: any) {
      showStatus(`Error al guardar contacto: ${err.message}`, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = `<span>Guardar Cambios de Contacto y Mapa</span>`;
    }
  });

  btnRestoreContact?.addEventListener('click', async () => {
    if (!confirm('¿Deseas restaurar todos los datos de contacto y mapa a los valores predeterminados?')) return;
    try {
      await Promise.all([
        saveSetting('whatsapp_number', DEFAULT_SETTINGS.whatsapp_number),
        saveSetting('phone_display', DEFAULT_SETTINGS.phone_display),
        saveSetting('email', DEFAULT_SETTINGS.email),
        saveSetting('address', DEFAULT_SETTINGS.address),
        saveSetting('city_state', DEFAULT_SETTINGS.city_state),
        saveSetting('map_embed_url', DEFAULT_SETTINGS.map_embed_url)
      ]);

      if (cfgWa) cfgWa.value = DEFAULT_SETTINGS.whatsapp_number;
      if (cfgPhone) cfgPhone.value = DEFAULT_SETTINGS.phone_display;
      if (cfgEmail) cfgEmail.value = DEFAULT_SETTINGS.email;
      if (cfgAddress) cfgAddress.value = DEFAULT_SETTINGS.address;
      if (cfgCity) cfgCity.value = DEFAULT_SETTINGS.city_state;
      if (cfgMap) cfgMap.value = DEFAULT_SETTINGS.map_embed_url;
      if (adminMapPreview) adminMapPreview.src = DEFAULT_SETTINGS.map_embed_url;

      showStatus('Información de contacto restaurada a los valores predeterminados.', 'success');
    } catch (err: any) {
      showStatus(`Error al restaurar: ${err.message}`, 'error');
    }
  });

  // Inicializar al cargar
  checkAuth();
</script>
