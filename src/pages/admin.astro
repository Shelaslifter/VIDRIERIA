---
// src/pages/admin.astro - Panel de Administración completo (4 pestañas)
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout title="Panel de Administración - VIDRIERIA">
  <div class="min-h-screen bg-slate-950 text-white relative overflow-hidden pb-24">
    
    <!-- Luces ambientales de fondo -->
    <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
      <div class="absolute -top-24 left-1/4 h-96 w-96 rounded-full bg-cyan-500/10 blur-[130px]"></div>
      <div class="absolute top-1/2 right-1/4 h-96 w-96 rounded-full bg-blue-600/10 blur-[130px]"></div>
      <div class="absolute -bottom-20 left-1/3 h-96 w-96 rounded-full bg-cyan-400/10 blur-[130px]"></div>
    </div>

    <!-- Barra de navegación del Admin -->
    <header class="relative z-20 border-b border-white/10 bg-slate-900/60 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
        <div class="flex items-center gap-4">
          <Logo />
          <span class="rounded-full bg-cyan-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cyan-400 border border-cyan-400/20">
            Panel de Control
          </span>
        </div>

        <div class="flex items-center gap-4">
          <a href="/" target="_blank" class="btn-ghost py-2 px-4 text-xs sm:text-sm font-semibold flex items-center gap-1.5">
            <span>Ver Sitio Web</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <button id="btn-logout" class="hidden text-xs text-slate-400 hover:text-rose-400 transition-colors cursor-pointer">
            Cerrar Sesión
          </button>
        </div>
      </div>
    </header>

    <main class="relative z-10 mx-auto max-w-7xl px-6 pt-8">

      <!-- PANTALLA 1: Acceso de Seguridad (PIN / Clave de Acceso) -->
      <div id="auth-screen" class="mx-auto max-w-md mt-16 text-center">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-8 shadow-2xl backdrop-blur-xl">
          <div class="mx-auto mb-6 grid h-16 w-16 place-items-center rounded-2xl bg-cyan-500/10 text-cyan-400 ring-1 ring-cyan-400/20">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          
          <h2 class="text-2xl font-bold tracking-tight text-white mb-2">Acceso Administrador</h2>
          <p class="text-sm text-slate-400 mb-6">Ingresa la clave de acceso para gestionar tu sitio web.</p>

          <form id="auth-form" class="space-y-4">
            <div>
              <input 
                type="password" 
                id="admin-pin" 
                class="w-full rounded-xl border border-white/15 bg-slate-900/90 px-4 py-3.5 text-center text-lg tracking-widest text-white shadow-inner focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/30 transition-all placeholder:tracking-normal placeholder:text-slate-500" 
                placeholder="Ingresa tu contraseña"
                required
              />
              <p id="auth-error" class="hidden mt-2 text-xs text-rose-400">Contraseña incorrecta. Inténtalo de nuevo.</p>
            </div>
            
            <button type="submit" class="btn-primary w-full py-3.5 text-sm font-semibold justify-center cursor-pointer">
              Entrar al Panel
            </button>
          </form>

          <p class="mt-6 text-xs text-slate-500">
            * Clave predeterminada inicial: <code class="text-cyan-400 font-mono">admin123</code>
          </p>
        </div>
      </div>

      <!-- PANTALLA 2: Panel de Gestión Principal -->
      <div id="dashboard-screen" class="hidden">
        
        <!-- Notificaciones de Alerta Global -->
        <div id="status-alert" class="hidden mb-6 rounded-2xl p-4 text-sm font-medium transition-all duration-300"></div>

        <!-- Barra de Pestañas (Tabs) -->
        <div class="mb-8 border-b border-white/10 pb-4">
          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
            
            <button 
              id="tab-btn-projects" 
              class="tab-btn active inline-flex items-center gap-2 rounded-xl border border-cyan-500/30 bg-cyan-500/20 px-4 py-2.5 text-xs sm:text-sm font-semibold text-cyan-300 ring-1 ring-cyan-500/20 transition-all duration-200 cursor-pointer whitespace-nowrap"
              data-tab="projects"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
              <span>Catálogo de Proyectos</span>
            </button>

            <button 
              id="tab-btn-hero" 
              class="tab-btn inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-300 hover:bg-white/10 hover:text-white transition-all duration-200 cursor-pointer whitespace-nowrap"
              data-tab="hero"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Foto de Portada (Hero)</span>
            </button>

            <button 
              id="tab-btn-beforeafter" 
              class="tab-btn inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-300 hover:bg-white/10 hover:text-white transition-all duration-200 cursor-pointer whitespace-nowrap"
              data-tab="beforeafter"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
              <span>Antes y Después</span>
            </button>

            <button 
              id="tab-btn-contact" 
              class="tab-btn inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-300 hover:bg-white/10 hover:text-white transition-all duration-200 cursor-pointer whitespace-nowrap"
              data-tab="contact"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>Contacto y Mapa</span>
            </button>

          </div>
        </div>

        <!-- ========================================== -->
        <!-- PESTAÑA 1: CATÁLOGO DE PROYECTOS          -->
        <!-- ========================================== -->
        <div id="tab-content-projects" class="tab-pane">
          <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Catálogo de Proyectos</h1>
              <p class="mt-1 text-sm text-slate-400">Sube fotos de tus nuevos trabajos o elimina proyectos en tiempo real.</p>
            </div>
            
            <button id="btn-open-modal" class="btn-primary py-3 px-5 text-sm font-bold shadow-lg shadow-cyan-500/20 cursor-pointer">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              <span>Subir Nuevo Proyecto</span>
            </button>
          </div>

          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-200">Proyectos Publicados</h2>
            <span id="projects-count" class="text-xs text-slate-400 font-mono">Cargando...</span>
          </div>

          <div id="projects-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <div class="col-span-full py-16 text-center text-slate-500">
              <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-cyan-400 border-r-transparent"></div>
              <p class="mt-3 text-sm">Cargando proyectos desde Supabase...</p>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- PESTAÑA 2: FOTO DE PORTADA (HERO)          -->
        <!-- ========================================== -->
        <div id="tab-content-hero" class="tab-pane hidden">
          <div class="mb-8 max-w-2xl">
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Foto de Portada Principal</h1>
            <p class="mt-1 text-sm text-slate-400">Personaliza la imagen de bienvenida que ven tus clientes nada más entrar al sitio.</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Vista Previa en Vivo del Hero -->
            <div class="lg:col-span-7 rounded-3xl border border-white/10 bg-slate-900/60 p-6 backdrop-blur-xl">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Vista Previa Actual</span>
                <span class="rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-400 border border-emerald-500/20">
                  En Vivo en Sitio Web
                </span>
              </div>

              <div class="relative aspect-video w-full overflow-hidden rounded-2xl border border-white/10 bg-slate-950 shadow-2xl">
                <img id="hero-preview-img" src="" alt="Vista previa portada" class="h-full w-full object-cover object-center" />
                <div class="absolute inset-0 bg-linear-to-t from-slate-950/90 via-slate-950/40 to-slate-950/30"></div>
                
                <!-- Mockup de contenido encima de la imagen -->
                <div class="absolute inset-0 flex flex-col justify-end p-6 pointer-events-none">
                  <span class="inline-block rounded-full bg-cyan-400/20 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-cyan-300 w-max mb-2">
                    Calidad Premium
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-white leading-tight">Transparencia y Elegancia para tus Espacios</h3>
                  <p class="text-xs text-slate-300 line-clamp-1 mt-1">Especialistas en diseño, fabricación e instalación a medida.</p>
                </div>
              </div>

              <p class="mt-3 text-[11px] text-slate-500">
                * Recomendación: Imagen panorámica horizontal de alta calidad (1920x1080 o superior).
              </p>
            </div>

            <!-- Formulario de Cambio de Portada -->
            <div class="lg:col-span-5 rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl space-y-5">
              <h2 class="text-lg font-bold text-white">Cambiar Imagen</h2>

              <!-- Subir Archivo -->
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-cyan-300 mb-2">
                  1. Subir fotografía desde tu dispositivo
                </label>
                <div class="relative flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-white/20 p-6 text-center hover:border-cyan-400 hover:bg-white/5 transition-all bg-slate-950/40 cursor-pointer group">
                  <input type="file" id="hero-file-input" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" />
                  <div class="mx-auto mb-2 grid h-12 w-12 place-items-center rounded-2xl bg-cyan-500/10 text-cyan-400 group-hover:scale-110 transition-transform">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <p class="text-xs font-medium text-slate-200" id="hero-file-label">Seleccionar foto de portada</p>
                  <p class="text-[11px] text-slate-400 mt-1">JPG, PNG o WEBP</p>
                </div>
              </div>

              <!-- O Ingresar URL Directa -->
              <div>
                <label for="hero-url-input" class="block text-xs font-semibold uppercase tracking-wider text-cyan-300 mb-2">
                  O pegar enlace web directo (URL)
                </label>
                <input 
                  type="url" 
                  id="hero-url-input" 
                  class="w-full rounded-xl border border-white/15 bg-slate-950/70 px-4 py-3 text-xs sm:text-sm text-white placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/30 transition-all"
                  placeholder="https://images.unsplash.com/..."
                />
              </div>

              <!-- Botones de Acción -->
              <div class="pt-4 flex flex-col gap-3">
                <button 
                  type="button" 
                  id="btn-save-hero" 
                  class="btn-primary w-full py-3.5 text-sm font-bold justify-center cursor-pointer shadow-lg shadow-cyan-500/25"
                >
                  <span>Guardar y Aplicar Portada</span>
                </button>

                <button 
                  type="button" 
                  id="btn-restore-hero" 
                  class="btn-ghost w-full py-3 text-xs font-semibold text-slate-400 hover:text-white justify-center cursor-pointer"
                >
                  Restaurar Portada Predeterminada
                </button>
              </div>

            </div>

          </div>
        </div>

        <!-- ========================================== -->
        <!-- PESTAÑA 3: ANTES Y DESPUÉS                -->
        <!-- ========================================== -->
        <div id="tab-content-beforeafter" class="tab-pane hidden">
          <div class="mb-8 max-w-2xl">
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Transformación Antes y Después</h1>
            <p class="mt-1 text-sm text-slate-400">Actualiza las dos fotografías del comparador interactivo para mostrar la calidad de tu trabajo.</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Vista Previa Comparativa -->
            <div class="lg:col-span-7 rounded-3xl border border-white/10 bg-slate-900/60 p-6 backdrop-blur-xl">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Comparativa Actual</span>
                <span class="text-xs text-slate-400 font-mono">Desliza la barra central</span>
              </div>

              <!-- Slider Interactivo de Prueba -->
              <div class="relative aspect-video w-full overflow-hidden rounded-2xl border border-white/10 bg-slate-950 shadow-2xl select-none" id="admin-ba-container">
                <!-- Imagen Después (Fondo) -->
                <img id="admin-after-preview" src="" alt="Después" class="absolute inset-0 h-full w-full object-cover pointer-events-none" />
                
                <!-- Imagen Antes (Capa con recorte) -->
                <div class="absolute inset-y-0 left-0 overflow-hidden w-1/2" id="admin-before-clipper">
                  <img id="admin-before-preview" src="" alt="Antes" class="absolute inset-0 h-full w-full max-w-none object-cover pointer-events-none" />
                </div>

                <!-- Línea Divisoria -->
                <div class="absolute inset-y-0 left-1/2 -ml-0.5 w-1 bg-cyan-400 shadow-[0_0_12px_rgba(34,211,238,0.8)]" id="admin-ba-divider">
                  <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 h-8 w-8 rounded-full bg-cyan-400 text-slate-950 flex items-center justify-center font-bold text-xs shadow-lg">
                    ⇄
                  </div>
                </div>

                <!-- Etiquetas de Esquinas -->
                <span class="absolute top-3 left-3 rounded-md bg-black/60 px-2 py-1 text-[10px] font-bold text-white backdrop-blur-md">
                  ANTES
                </span>
                <span class="absolute top-3 right-3 rounded-md bg-cyan-500/80 px-2 py-1 text-[10px] font-bold text-slate-950 backdrop-blur-md">
                  DESPUÉS
                </span>
              </div>

              <!-- Control Slider Rápido -->
              <div class="mt-4 flex items-center gap-4">
                <span class="text-xs text-slate-400 font-semibold">Antes</span>
                <input type="range" id="admin-ba-range" min="0" max="100" value="50" class="w-full accent-cyan-400 cursor-pointer" />
                <span class="text-xs text-cyan-400 font-semibold">Después</span>
              </div>
            </div>

            <!-- Formularios de Subida (Antes & Después) -->
            <div class="lg:col-span-5 rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl space-y-6">
              
              <!-- Foto ANTES -->
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-amber-300 mb-2">
                  1. Foto del "Antes" (Espacio sin remodelar)
                </label>
                <div class="relative flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-white/20 p-4 text-center hover:border-amber-400 hover:bg-white/5 transition-all bg-slate-950/40 cursor-pointer group">
                  <input type="file" id="before-file-input" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" />
                  <p class="text-xs font-medium text-slate-200" id="before-file-label">Subir foto Antes</p>
                  <p class="text-[10px] text-slate-500 mt-0.5">O arrastra el archivo</p>
                </div>
                <input 
                  type="url" 
                  id="before-url-input" 
                  class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/70 px-3 py-2 text-xs text-white placeholder:text-slate-500 focus:border-amber-400 focus:outline-none"
                  placeholder="O URL directa de la foto Antes"
                />
              </div>

              <!-- Foto DESPUÉS -->
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-cyan-300 mb-2">
                  2. Foto del "Después" (Trabajo terminado)
                </label>
                <div class="relative flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-white/20 p-4 text-center hover:border-cyan-400 hover:bg-white/5 transition-all bg-slate-950/40 cursor-pointer group">
                  <input type="file" id="after-file-input" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" />
                  <p class="text-xs font-medium text-slate-200" id="after-file-label">Subir foto Después</p>
                  <p class="text-[10px] text-slate-500 mt-0.5">O arrastra el archivo</p>
                </div>
                <input 
                  type="url" 
                  id="after-url-input" 
                  class="mt-2 w-full rounded-xl border border-white/15 bg-slate-950/70 px-3 py-2 text-xs text-white placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none"
                  placeholder="O URL directa de la foto Después"
                />
              </div>

              <!-- Botones de Acción -->
              <div class="pt-2 flex flex-col gap-3">
                <button 
                  type="button" 
                  id="btn-save-beforeafter" 
                  class="btn-primary w-full py-3.5 text-sm font-bold justify-center cursor-pointer shadow-lg shadow-cyan-500/25"
                >
                  <span>Guardar Ambas Fotos</span>
                </button>

                <button 
                  type="button" 
                  id="btn-restore-beforeafter" 
                  class="btn-ghost w-full py-3 text-xs font-semibold text-slate-400 hover:text-white justify-center cursor-pointer"
                >
                  Restaurar Fotos Predeterminadas
                </button>
              </div>

            </div>

          </div>
        </div>

        <!-- ========================================== -->
        <!-- PESTAÑA 4: CONTACTO, TELÉFONOS Y MAPA     -->
        <!-- ========================================== -->
        <div id="tab-content-contact" class="tab-pane hidden">
          <div class="mb-8 max-w-2xl">
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Contacto, Teléfonos y Ubicación</h1>
            <p class="mt-1 text-sm text-slate-400">
              Modifica los números de WhatsApp, llamadas, correo, dirección y el mapa de Google Maps para todo el sitio.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Formulario de Campos de Contacto -->
            <div class="lg:col-span-7 rounded-3xl border border-white/10 bg-white/5 p-6 sm:p-8 backdrop-blur-xl">
              <form id="contact-settings-form" class="space-y-5">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <!-- WhatsApp -->
                  <div>
                    <label for="cfg-wa" class="block text-xs font-semibold uppercase tracking-wider text-cyan-300 mb-1.5">
                      WhatsApp (Número directo) <span class="text-rose-400">*</span>
                    </label>
                    <input 
                      type="text" 
                      id="cfg-wa" 
                      class="w-full rounded-xl border border-white/15 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/30" 
                      placeholder="Ej. 525627320080" 
                      required 
                    />
                    <p class="mt-1 text-[11px] text-slate-500">Con lada de país sin espacios ni signos (Ej. 52...)</p>
                  </div>

                  <!-- Teléfono de Llamadas -->
                  <div>
                    <label for="cfg-phone" class="block text-xs font-semibold uppercase tracking-wider text-cyan-300 mb-1.5">
                      Teléfono Visible (Llamadas) <span class="text-rose-400">*</span>
                    </label>
                    <input 
                      type="text" 
                      id="cfg-phone" 
                      class="w-full rounded-xl border border-white/15 bg-slate-950/70 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/30" 
                      placeholder="Ej. +52 56 2732 0080" 
                      required 
                    />
