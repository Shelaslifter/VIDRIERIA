---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/Contact.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout title="Contacto y Cotización - VIDRIERIA">
  <Navbar />
  
  <main class="pt-20">
    <div class="bg-slate-900 py-16 text-center text-white relative overflow-hidden">
      <!-- Decoraciones de fondo -->
      <div class="absolute inset-0 z-0 opacity-20">
        <div class="absolute top-0 right-0 w-64 h-64 bg-cyan-500 rounded-full blur-[100px]"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-cyan-500 rounded-full blur-[100px]"></div>
      </div>
      <div class="relative z-10 max-w-4xl mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Cotiza tu Proyecto</h1>
        <p class="text-xl text-slate-300 font-light max-w-2xl mx-auto">
          Nos especializamos en convertir tus ideas en realidad. Completa el formulario y uno de nuestros expertos te contactará a la brevedad.
        </p>
      </div>
    </div>
    
    <!-- El componente de contacto ya tiene su propio espaciado, pero le quitamos el título superior para que fluya mejor -->
    <ContactForm />

    <!-- Sección del Mapa -->
    <section class="pb-24 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden p-6 lg:p-8">
          <div class="mb-6 flex items-center justify-between">
            <h3 class="text-2xl font-bold text-slate-900">Nuestra Ubicación</h3>
            <span class="text-slate-500 text-sm hidden sm:block">Nezahualcóyotl, Estado de México</span>
          </div>
          <!-- Grid opcional si en el futuro se añade más contenido al lado, por ahora es 1 columna que ocupa todo -->
          <div class="grid grid-cols-1 gap-8">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d120462.14731872583!2d-99.11708849495806!3d19.400551000674635!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d1e2e1327c593f%3A0xc30353c7c77c6f05!2sNezahualc%C3%B3yotl%2C%20Estado%20de%20M%C3%A9xico!5e0!3m2!1ses-419!2smx!4v1700000000000!5m2!1ses-419!2smx" 
              class="w-full h-64 md:h-96 rounded-xl shadow-lg border-0"
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación de Vidrieria"
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <footer class="bg-slate-950 py-12 text-center text-slate-400 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-6 flex justify-center">
        <span class="text-2xl font-bold tracking-tighter text-white">
          VIDRIE<span class="text-cyan-600">RIA</span>
        </span>
      </div>
      <p>&copy; {new Date().getFullYear()} VIDRIERIA. Todos los derechos reservados.</p>
    </div>
  </footer>

  <WhatsAppButton />
</Layout>
