---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/Contact.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getSiteSettings } from '../lib/settings';

const settings = await getSiteSettings();

function extractDestination(embedUrl: string): string {
  if (!embedUrl) return '22.2169526,-100.9785857';
  const qMatch = embedUrl.match(/[?&]q=([^&]+)/);
  if (qMatch && qMatch[1]) {
    return decodeURIComponent(qMatch[1]);
  }
  const atMatch = embedUrl.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
  if (atMatch) {
    return `${atMatch[1]},${atMatch[2]}`;
  }
  return '22.2169526,-100.9785857';
}

const destination = extractDestination(settings.map_embed_url);
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(destination)}`;
---

<Layout title="Contacto y Cotización - DELTALUM">
  <Navbar />
  
  <main class="pt-24">
    <!-- Header Section -->
    <div class="relative overflow-hidden bg-slate-950 py-20 text-center text-white">
      <!-- Decoraciones de fondo -->
      <div class="pointer-events-none absolute inset-0 z-0">
        <div class="absolute right-0 top-0 h-96 w-96 rounded-full bg-cyan-500/10 blur-[100px]"></div>
        <div class="absolute bottom-0 left-0 h-96 w-96 rounded-full bg-blue-600/10 blur-[100px]"></div>
        <div class="absolute inset-x-0 bottom-0 h-px bg-linear-to-r from-transparent via-cyan-500/20 to-transparent"></div>
      </div>
      
      <div class="relative z-10 mx-auto max-w-4xl px-6">
        <span class="eyebrow mb-4 inline-block text-cyan-400">Atención Personalizada</span>
        <h1 class="mb-6 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">Cotiza tu Proyecto</h1>
        <p class="mx-auto max-w-2xl text-lg text-slate-300 sm:text-xl">
          Nos especializamos en convertir tus ideas en realidad. Completa el formulario y uno de nuestros expertos te contactará a la brevedad.
        </p>
      </div>
    </div>
    
    <!-- Contact Form Section -->
    <ContactForm />

    <!-- Map & Navigation Section -->
    <section class="bg-slate-50 pb-24 md:pb-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="group overflow-hidden rounded-[2.5rem] bg-white p-2 sm:p-3 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 transition-shadow duration-500 hover:shadow-2xl hover:shadow-cyan-900/10">
          <!-- Map Frame -->
          <div class="relative overflow-hidden rounded-[2rem]">
            <!-- Top Glassmorphic Header -->
            <div class="pointer-events-none absolute inset-x-0 top-0 z-10 flex items-center justify-between bg-linear-to-b from-slate-950/85 via-slate-950/40 to-transparent px-6 pb-12 pt-6 text-white sm:px-8 sm:pt-8">
              <div class="flex items-center gap-3">
                <span class="flex h-3 w-3 relative">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-cyan-500"></span>
                </span>
                <h3 class="text-lg font-bold tracking-tight drop-shadow-md sm:text-xl">Nuestra Ubicación</h3>
              </div>
              <span id="map-city-state" class="rounded-full bg-slate-900/70 px-3.5 py-1 text-xs font-medium text-cyan-300 backdrop-blur-md ring-1 ring-white/20 sm:px-4 sm:text-sm">
                {settings.city_state}
              </span>
            </div>
            
            <iframe 
              id="map-iframe"
              src={settings.map_embed_url} 
              class="h-80 w-full border-0 transition-all duration-700 sm:h-96 md:h-[460px]"
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación de DELTALUM en Google Maps"
            ></iframe>
            
            <!-- Floating Quick-Action GPS Pill on Map -->
            <div class="pointer-events-none absolute inset-x-0 bottom-4 z-10 flex justify-center px-4 sm:justify-end sm:px-6">
              <a
                id="map-floating-directions"
                href={directionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-slate-950/90 px-4 py-2.5 text-xs font-bold text-white shadow-xl shadow-slate-950/40 ring-1 ring-white/20 backdrop-blur-md transition-all hover:scale-105 hover:bg-cyan-500 hover:text-slate-950 sm:text-sm"
              >
                <svg class="h-4 w-4 text-cyan-400 group-hover:text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>Abrir ubicación en Google Maps</span>
                <svg class="h-3.5 w-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Interactive Navigation & Address Footer Bar -->
          <div class="mt-2 flex flex-col justify-between gap-5 rounded-[1.75rem] bg-slate-950 p-5 text-white sm:p-7 lg:flex-row lg:items-center">
            <!-- Address Info -->
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-cyan-500/10 text-cyan-400 ring-1 ring-cyan-500/30">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-widest text-cyan-400">Dirección Oficial • Taller y Atención</span>
                <p id="map-address-text" class="mt-1 text-base font-bold text-white sm:text-lg">
                  {settings.address}
                </p>
                <p id="map-city-subtitle" class="mt-0.5 text-xs text-slate-400 sm:text-sm">
                  {settings.city_state}
                </p>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center lg:shrink-0">
              <button
                type="button"
                id="btn-copy-address"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-white/10 px-4 py-3 text-sm font-semibold text-slate-200 ring-1 ring-white/15 transition-all hover:bg-white/15 hover:text-white active:scale-[0.98] cursor-pointer"
              >
                <svg id="copy-icon-default" class="h-4 w-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <svg id="copy-icon-check" class="hidden h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span id="copy-btn-label">Copiar dirección</span>
              </button>

              <a
                id="btn-open-maps"
                href={directionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-cyan-500 px-6 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-cyan-500/25 transition-all hover:bg-cyan-400 hover:shadow-cyan-400/30 active:scale-[0.98]"
              >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                <span>Cómo llegar (Abrir en Maps)</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <WhatsAppButton />
</Layout>

<script>
  import { getCachedSiteSettings } from '../lib/settings';

  function buildDirectionsUrl(embedUrl: string): string {
    if (!embedUrl) return 'https://www.google.com/maps/dir/?api=1&destination=22.2169526,-100.9785857';
    const qMatch = embedUrl.match(/[?&]q=([^&]+)/);
    if (qMatch && qMatch[1]) {
      return `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(decodeURIComponent(qMatch[1]))}`;
    }
    const atMatch = embedUrl.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
    if (atMatch) {
      return `https://www.google.com/maps/dir/?api=1&destination=${atMatch[1]},${atMatch[2]}`;
    }
    return 'https://www.google.com/maps/dir/?api=1&destination=22.2169526,-100.9785857';
  }

  async function syncMap() {
    try {
      const settings = await getCachedSiteSettings();
      if (settings) {
        if (settings.map_embed_url) {
          const iframe = document.getElementById('map-iframe') as HTMLIFrameElement;
          if (iframe && iframe.src !== settings.map_embed_url) {
            iframe.src = settings.map_embed_url;
          }
          const dirUrl = buildDirectionsUrl(settings.map_embed_url);
          const btnMaps = document.getElementById('btn-open-maps') as HTMLAnchorElement | null;
          const floatMaps = document.getElementById('map-floating-directions') as HTMLAnchorElement | null;
          if (btnMaps) btnMaps.href = dirUrl;
          if (floatMaps) floatMaps.href = dirUrl;
        }
        if (settings.address) {
          const addrEl = document.getElementById('map-address-text');
          if (addrEl) addrEl.textContent = settings.address;
        }
        if (settings.city_state) {
          const el = document.getElementById('map-city-state');
          if (el) el.textContent = settings.city_state;
          const subEl = document.getElementById('map-city-subtitle');
          if (subEl) subEl.textContent = settings.city_state;
        }
      }
    } catch (e) {}
  }

  // Copy address button logic
  const copyBtn = document.getElementById('btn-copy-address');
  copyBtn?.addEventListener('click', async () => {
    const addrText = document.getElementById('map-address-text')?.textContent?.trim() || '';
    const cityText = document.getElementById('map-city-subtitle')?.textContent?.trim() || '';
    const fullAddress = cityText ? `${addrText}, ${cityText}` : addrText;

    try {
      await navigator.clipboard.writeText(fullAddress);
      const label = document.getElementById('copy-btn-label');
      const iconDefault = document.getElementById('copy-icon-default');
      const iconCheck = document.getElementById('copy-icon-check');

      if (label) label.textContent = '¡Dirección copiada!';
      iconDefault?.classList.add('hidden');
      iconCheck?.classList.remove('hidden');

      setTimeout(() => {
        if (label) label.textContent = 'Copiar dirección';
        iconCheck?.classList.add('hidden');
        iconDefault?.classList.remove('hidden');
      }, 2500);
    } catch (err) {}
  });

  syncMap();
</script>
